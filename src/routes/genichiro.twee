:: Go_Genichiro {"position":"2050,1725","size":"100,100"}
<<set $currentRoute = "genichiro">>
<<run setup.ensureTimeVariables && setup.ensureTimeVariables()>>

<<if ($dayCount || $day || 1) < 5>>
  <<goto "Genichiro_NotYet">>
<<elseif not $genichiroReturnNoticeSeen and not $genichiroArrowEventSeen and not $genichiroGateSeen>>
  <<goto "Genichiro_ReturnNotice">>
<<elseif not $genichiroArrowEventSeen and not $genichiroGateSeen>>
  <<goto "Genichiro_ArrowIntro">>
<<elseif not $genichiroGateSeen>>
  <<goto "Genichiro_01_Gate">>
<<elseif not $genichiroRooftopSeen>>
  <<goto "Genichiro_02_Rooftop">>
<<elseif not ($genichiroWatchPostSeen || false)>>
  <<goto "Genichiro_02b_WatchPost">>
<<elseif not $genichiroFullDuelSeen>>
  <<goto "Genichiro_03_FullDuel">>
<<elseif not ($genichiroAfterDuelSeen || false)>>
  <<goto "Genichiro_03b_AfterDuelDistance">>
<<elseif not $genichiroMoonSakeSeen>>
  <<goto "Genichiro_04_MoonSake">>
<<elseif not ($genichiroMidConflictSeen || false) and (((($genichiroAffection || 0) + ($genichiroConflict || 0)) >= 2) or (($genichiroLove || 0) >= 2)) and (($danger || 0) >= 3)>>
  <<goto "Genichiro_MidConflict">>
<<elseif not $genichiroWoundSeen>>
  <<goto "Genichiro_05_Wound">>
<<elseif not $genichiroAshinaConfessionSeen>>
  <<goto "Genichiro_06_AshinaConfession">>
<<elseif not $genichiroDoNotReturnSeen>>
  <<goto "Genichiro_07_DoNotReturn">>
<<elseif not $genichiroDone>>
  <<goto "Genichiro_EndingRouter">>
<<else>>
  <<goto "Genichiro_AfterEnding">>
<</if>>

