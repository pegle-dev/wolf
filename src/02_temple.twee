:: Temple {"position":"1525,450","size":"100,100"}
<<page>>
<<run setup.ensureTimeVariables && setup.ensureTimeVariables()>>
<<set $timeOfDay = "day">>
<<if (($nightFoundOwlTrace || false) or (($nightOwlTraceCount || 0) > 0)) and not $owlReactedNightFootsteps>>
  <<set $nightReactionReturn = "Temple">>
  <<goto "Owl_React_NightFootsteps">>
<</if>>
<<set _commonBadAffectionTotal = ($hanbeiAffection || 0) + ($kuroAffection || 0) + ($genichiroAffection || 0) + ($sculptorAffection || 0) + ($isshinAffection || 0) + ($emmaAffection || 0)>>
<<set _commonBadOwlVoiceTotal = ($owlVoiceCount || 0) + ($fatherObedienceCount || 0) + ($missionObedienceCount || 0)>>
<<set _commonBadRefusedHelpTotal = ($refusedHelpCount || 0) + ($helpRefusedCount || 0)>>
<<set _commonBadShuraWarningSeen = (($sculptorShuraWarningSeen || false) or ($sculptorShuraPreludeSeen || false) or ($isshinShuraWarningSeen || false) or ($isshinShuraPreludeSeen || false))>>
<<if (($shura || 0) >= 5 and ($shuraHintSeen || false) and _commonBadShuraWarningSeen) or (_commonBadOwlVoiceTotal >= 4 and ($isolation || 0) >= 5 and ($danger || 0) >= 4 and _commonBadRefusedHelpTotal >= 2 and ($shura || 0) < 5 and not ($endingHiddenOwlsWolfSeen || false)) or (($danger || 0) >= 7 and ($shura || 0) < 5 and not ($endingShuraSeen || false) and not ($shuraEndingSeen || false)) or (($isolation || 0) >= 7 and _commonBadAffectionTotal < 3 and not ($endingShuraSeen || false) and not ($shuraEndingSeen || false))>>
  <<goto "CommonBadEndRouter">>
<</if>>
<<include "Temple_Description">>
<<include "Temple_CharacterEcho">>

<<if $recordBookUnlocked and not $recordBookFirstOpened>>
<<run setup.showToast && setup.showToast(setup.t("recordSomethingRemains"), "record")>>
<</if>>

<div class="choice-box temple-hub-choices temple-choice-box">
<<include "Temple_Choices">>
</div>
<</page>>

:: Temple_Description {"position":"1525,575","size":"100,100"}
<div class="narration"><<if $shura >= 8>>
<<print either(
  "검집 안에서 작은 소리가 난다.",
  "불상은 말이 없으나, 시선은 느껴진다.",
  "바람 끝에 피 냄새가 스쳤다.",
  "손은 아직 검을 놓지 못한다."
)>>
<<elseif $isolation >= 8>>
<<print either(
  "이제는 아무 소리도 들리지 않는다.",
  "머무는 이들의 그림자마저 멀다.",
  "늑대의 발소리만이 남는다.",
  "이곳은 쉬는 곳이 아니라, 버티는 곳이 되었다."
)>>
<<elseif $day >= 7>>
<<print either(
  "오래 머물 곳이 아니라고 생각했다. 하지만 떠나지 않은 것들이 이곳에도 하나씩 쌓이고 있었다.",
  "같은 바람을 여러 번 맞고 나면, 돌아오는 길도 몸에 남는다.",
  "낡은 처마 아래에 며칠의 침묵이 겹겹이 내려앉아 있다."
)>>
<<elseif $day >= 4>>
<<print either(
  "돌아오는 길이 있다는 사실이 조금씩 몸에 익어 간다.",
  "며칠째 같은 바람이 불고 있다.",
  "발소리 하나쯤은 이제 구분할 수 있을 것 같다."
)>>
<<elseif $day >= 2>>
<<print either(
  "낯설던 침묵이 조금 낮아졌다.",
  "어제와 같은 바람이 처마 아래를 지난다.",
  "쉬어 가는 법을 몸이 아주 조금 기억한다."
)>>
<<else>>
<<print either(
  "바람만이 처마 아래를 지나간다.",
  "낡은 불상들 사이로 침묵이 내려앉아 있다.",
  "이상하게도, 이곳에서는 숨을 고를 수 있다.",
  "무너진 곳에도 머무는 이들은 있다.",
  "불상 깎는 소리가 낮게 이어진다."
)>>
<</if>></div>

:: Temple_CharacterEcho {"position":"1525,700","size":"100,100"}
<<set _echoRoll = random(1, 100)>>
<<if _echoRoll <= 35 and $hanbeiLove >= 3>>
<div class="narration">
<<print either("어디선가 한베의 웃음소리가 들린 듯했다.", "훈련장 쪽에서 마른 흙이 밟히는 소리가 났다.")>>
</div>
<<elseif _echoRoll <= 35 and $kuroLove >= 3>>
<div class="narration">
<<print either("쿠로의 방 쪽에 희미한 불빛이 남아 있다.", "닫힌 문 너머로 낮은 숨소리가 느껴졌다.")>>
</div>
<<elseif _echoRoll <= 35 and $genichiroLove >= 3>>
<div class="narration">
<<print either("먼 성 쪽에서 활시위가 우는 듯했다.", "아시나 망루 쪽의 바람이 유난히 차다.")>>
</div>
<<elseif _echoRoll <= 35 and $sculptorLove >= 3>>
<div class="narration">
<<print either("불상 깎는 소리가 낮게 이어진다.", "조각가의 칼끝이 나무를 천천히 파고든다.")>>
</div>
<<elseif _echoRoll <= 35 and $isshinLove >= 3>>
<div class="narration">
<<print either("어디선가 술잔이 놓이는 소리가 났다.", "갈대밭 같은 웃음이 바람에 섞인 듯했다.")>>
</div>
<</if>>

