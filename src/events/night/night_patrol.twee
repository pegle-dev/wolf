:: NightPatrol_Random {"position":"2000,925","size":"100,100"}
<<run setup.ensureTimeVariables && setup.ensureTimeVariables()>>
<<set $timeOfDay = "night">>
<<set $nightPatrolActive = true>>
<<set $nightPatrolUsedToday = true>>
<<set $nightPatrolJustFinished = false>>
<<set $currentMode = "nightPatrol">>
<<set _place = random(1, 5)>>
<<if _place == 1>>
  <<goto "NightPatrol_Place_Temple">>
<<elseif _place == 2>>
  <<goto "NightPatrol_Place_Water">>
<<elseif _place == 3>>
  <<goto "NightPatrol_Place_AshinaUnder">>
<<elseif _place == 4>>
  <<goto "NightPatrol_Place_Battlefield">>
<<else>>
  <<goto "NightPatrol_Place_ReedField">>
<</if>>

:: NightPatrol_LocationChoice {"position":"2075,875","size":"100,100"}
<<page>>
<<run setup.ensureTimeVariables && setup.ensureTimeVariables()>>
<<set $timeOfDay = "night">>
<<run setup.ensureBondVariables && setup.ensureBondVariables()>>
<div class="choice-screen night-patrol-choice-screen">
<div class="choice-prompt">오늘 밤, 어디를 살필까.</div>

<div class="global-choice-layer">
<div class="global-choice-box">
<<choiceTo "황폐한 절 주변" "NightPatrol_Place_Temple">>
<<choiceTo "물가" "NightPatrol_Place_Water">>
<<choiceTo "아시나 성 아래" "NightPatrol_Place_AshinaUnder">>
<<choiceTo "버려진 전장" "NightPatrol_Place_Battlefield">>
<<choiceTo "갈대밭" "NightPatrol_Place_ReedField">>
<<choiceTo "아무 곳이나 걷는다" "NightPatrol_Random">>
<<choiceTo "돌아간다" "NightPatrol_Cancel">>
</div>
</div>
</div>
<</page>>

:: NightPatrol_Cancel {"position":"2075,950","size":"100,100"}
<<set $nightPatrolActive = false>>
<<set $nightPatrolUsedToday = false>>
<<set $nightPatrolJustFinished = false>>
<<set $currentMode = "temple">>
<<set $timeOfDay = "night">>
<<goto "Temple_Return">>

:: NightPatrol_Place_Temple {"position":"2200,875","size":"100,100"}
<<set $nightPatrolPlace = "temple">>
<<set $nightPatrolCount = ($nightPatrolCount || 0) + 1>>
<<set $nightVisitedTemple = true>>
<<set _roll = random(1, 100)>>
<<if ($shura || 0) >= 3 and _roll <= 24>>
  <<goto "NightPatrol_Temple_ShuraHand">>
<<elseif _roll <= 16>>
  <<goto "NightPatrol_Temple_HanbeiTrace">>
<<elseif _roll <= 32>>
  <<goto "NightPatrol_Temple_SculptorSound">>
<<elseif _roll <= 48>>
  <<goto "NightPatrol_Temple_EmmaMedicine">>
<<elseif _roll <= 64>>
  <<goto "NightPatrol_Temple_EmptyYard">>
<<elseif _roll <= 82>>
  <<goto "NightPatrol_Temple_RainUnderEaves">>
<<else>>
  <<goto "NightPatrol_Temple_ShuraHand">>
<</if>>

:: NightPatrol_Place_Water {"position":"2200,925","size":"100,100"}
<<set $nightPatrolPlace = "water">>
<<set $nightPatrolCount = ($nightPatrolCount || 0) + 1>>
<<set $nightVisitedWater = true>>
<<set _roll = random(1, 100)>>
<<if ($hanbeiEchoSeen || $kuroEchoSeen || $genichiroEchoSeen || $sculptorEchoSeen || $isshinEchoSeen) and _roll <= 18>>
  <<goto "NightPatrol_Water_EchoVoice">>
<<elseif $kuroTeaSeen and _roll <= 34>>
  <<goto "NightPatrol_Water_TeaScent">>
<<elseif _roll <= 18>>
  <<goto "NightPatrol_Water_KuroLantern">>
<<elseif _roll <= 36>>
  <<goto "NightPatrol_Water_HandReflection">>
<<elseif _roll <= 54>>
  <<goto "NightPatrol_Water_EmmaHerbs">>
<<elseif _roll <= 72>>
  <<goto "NightPatrol_Water_LateFace">>
<<elseif _roll <= 88>>
  <<goto "NightPatrol_Water_Arrow">>
<<else>>
  <<goto "NightPatrol_Water_Reflection">>
<</if>>

:: NightPatrol_Place_AshinaUnder {"position":"2200,975","size":"100,100"}
<<set $nightPatrolPlace = "ashina_under">>
<<set $nightPatrolCount = ($nightPatrolCount || 0) + 1>>
<<set $nightVisitedCastle = true>>
<<set _roll = random(1, 100)>>
<<if (($genichiroAffection || 0) + ($genichiroConflict || 0) >= 2 or ($nightGenichiroTraceCount || 0) >= 2) and _roll <= 25>>
  <<goto "NightPatrol_Castle_GenichiroNear">>
<<elseif _roll <= 16>>
  <<goto "NightPatrol_Castle_Rumor">>
<<elseif _roll <= 32>>
  <<goto "NightPatrol_Castle_Gaze">>
<<elseif _roll <= 48>>
  <<goto "NightPatrol_Castle_Arrow">>
<<elseif _roll <= 64>>
  <<goto "NightPatrol_Castle_Lights">>
<<elseif _roll <= 80>>
  <<goto "NightPatrol_Castle_HeadlessRumor">>
<<else>>
  <<goto "NightPatrol_AshinaUnder_Patrol">>
<</if>>

:: NightPatrol_Place_Battlefield {"position":"2200,1025","size":"100,100"}
<<set $nightPatrolPlace = "battlefield">>
<<set $nightPatrolCount = ($nightPatrolCount || 0) + 1>>
<<set $nightVisitedBattlefield = true>>
<<set _roll = random(1, 100)>>
<<if ($shura || 0) >= 3 and _roll <= 25>>
  <<goto "NightPatrol_Battlefield_ShuraPulse">>
<<elseif _roll <= 16>>
  <<goto "NightPatrol_Battlefield_Armor">>
<<elseif _roll <= 32>>
  <<goto "NightPatrol_Battlefield_InnerBlade">>
<<elseif _roll <= 48>>
  <<goto "NightPatrol_Battlefield_BreathingEnemy">>
<<elseif _roll <= 64>>
  <<goto "NightPatrol_Battlefield_IsshinLaugh">>
<<elseif _roll <= 80>>
  <<goto "NightPatrol_Battlefield_SculptorHand">>
<<else>>
  <<goto "NightPatrol_Battlefield_ShuraPulse">>
<</if>>

:: NightPatrol_Place_ReedField {"position":"2200,1075","size":"100,100"}
<<set $nightPatrolPlace = "reedfield">>
<<set $nightPatrolCount = ($nightPatrolCount || 0) + 1>>
<<set $nightVisitedReedField = true>>
<<set _roll = random(1, 100)>>
<<if ($hanbeiEchoSeen || false) and ($kuroEchoSeen || false) and ($genichiroEchoSeen || false) and ($sculptorEchoSeen || false) and ($isshinEchoSeen || false) and not ($endingHiddenRememberSeen || false) and _roll <= 25>>
  <<goto "NightPatrol_ReedField_HiddenRememberGate">>
<<elseif _roll <= 16>>
  <<goto "NightPatrol_ReedField_Walk">>
<<elseif _roll <= 32>>
  <<goto "NightPatrol_ReedField_Voices">>
<<elseif _roll <= 48>>
  <<goto "NightPatrol_ReedField_HeadlessSamurai">>
<<elseif _roll <= 64>>
  <<goto "NightPatrol_ReedField_OwlSteps">>
<<elseif _roll <= 80>>
  <<goto "NightPatrol_ReedField_NoOneCut">>
<<else>>
  <<goto "NightPatrol_ReedField_HiddenPath">>
<</if>>

:: NightPatrol_Roll {"position":"2125,925","size":"100,100"}
<<set $nightPatrolActive = true>>
<<set $nightPatrolUsedToday = true>>
<<set $nightPatrolJustFinished = false>>
<<set $currentMode = "nightPatrol">>
<<set $timeOfDay = "night">>
<<if $danger >= 14 and $isolation >= 10 and not $nightTrapHumiliationSeen>>
  <<goto "Night_TrapHumiliation">>
<<elseif $danger >= 10 and not $nightTrapCordSeen>>
  <<goto "Night_TrapCord">>
<</if>>

<<if random(1, 6) == 1>>
  <<goto "NightRisk_Router">>
<</if>>

<<set _place = random(1, 5)>>

<<if $danger >= 6 or $shura >= 5>>
  <<set _risk = "High">>
<<elseif $danger >= 3 or $isolation >= 4>>
  <<set _risk = "Mid">>
<<else>>
  <<set _risk = "Low">>
<</if>>

<<if _place == 1 and _risk == "Low">>
  <<goto "NightPatrol01_Low">>
<<elseif _place == 1 and _risk == "Mid">>
  <<goto "NightPatrol01_Mid">>
<<elseif _place == 1 and _risk == "High">>
  <<goto "NightPatrol01_High">>

<<elseif _place == 2 and _risk == "Low">>
  <<goto "NightPatrol02_Low">>
<<elseif _place == 2 and _risk == "Mid">>
  <<goto "NightPatrol02_Mid">>
<<elseif _place == 2 and _risk == "High">>
  <<goto "NightPatrol02_High">>

<<elseif _place == 3 and _risk == "Low">>
  <<goto "NightPatrol03_Low">>
<<elseif _place == 3 and _risk == "Mid">>
  <<goto "NightPatrol03_Mid">>
<<elseif _place == 3 and _risk == "High">>
  <<goto "NightPatrol03_High">>

<<elseif _place == 4 and _risk == "Low">>
  <<goto "NightPatrol04_Low">>
<<elseif _place == 4 and _risk == "Mid">>
  <<goto "NightPatrol04_Mid">>
<<elseif _place == 4 and _risk == "High">>
  <<goto "NightPatrol04_High">>

<<elseif _place == 5 and _risk == "Low">>
  <<goto "NightPatrol05_Low">>
<<elseif _place == 5 and _risk == "Mid">>
  <<goto "NightPatrol05_Mid">>
<<else>>
  <<goto "NightPatrol05_High">>
<</if>>

:: NightPatrol_End {"position":"2125,1050","size":"100,100"}
<<goto "Night_PatrolEnd">>

:: Night_PatrolEnd {"position":"2250,1050","size":"100,100"}
<<set $nightPatrolActive = false>>
<<set $nightPatrolJustFinished = true>>
<<set $traceFirstNightPatrol = true>>
<<set $currentMode = "temple">>
<<goto "AdvanceDay">>

:: NightRisk_Router {"position":"2250,650","size":"100,100"}
<<set $timeOfDay = "night">>
<<set $traceFirstNightPatrol = true>>
<<set $returnEventPending = true>>
<<set _risk = random(1, 5)>>

<<if _risk is 1>>
  <<goto "NightRisk_Arrow">>
<<elseif _risk is 2>>
  <<goto "NightRisk_Cord">>
<<elseif _risk is 3>>
  <<goto "NightRisk_HandMoves">>
<<elseif _risk is 4>>
  <<goto "NightRisk_WrongName">>
<<else>>
  <<goto "NightRisk_BloodScent">>
<</if>>

:: NightPatrol_Quiet {"position":"2250,550","size":"100,100"}
<<page>>
<div class="narration-screen">
<div class="narration narration-block">밤은 조용했다.

늑대는 절 바깥을 한 바퀴 돌고 돌아왔다.</div>
</div>

<<continueTo "Night_PatrolEnd">>
<</page>>

:: NightPatrol_Temple_Hanbei {"position":"2325,875","size":"100,100"}
<<page>>
<<set $nightMetHanbei = true>>
<<set $traceNightTempleHanbeiSeen = true>>
<<set $hanbeiAffection = ($hanbeiAffection || 0) + 1>>
<<set $recordBookNewTrace = true>>
<<set $recordBookNewBond = true>>
<<clampStats>>

<div class="narration-screen">
<div class="narration narration-block">황폐한 절 뒤편에서,
나무칼이 낮게 허공을 갈랐다.

한베는 늑대를 보고 손을 들었다.

밤에도 연습인가.
그는 웃었지만,
눈은 웃지 않았다.</div>
</div>

<<recordNotice "trace">>
<<recordNotice "bond">>
<<continueTo "Night_PatrolEnd">>
<</page>>

:: NightPatrol_Temple_KuroTrace {"position":"2450,875","size":"100,100"}
<<page>>
<<set $nightFoundKuroTrace = true>>
<<set $traceNightTempleKuroTraceSeen = true>>
<<set $kuroConflict = ($kuroConflict || 0) + 1>>
<<set $isolation = ($isolation || 0) + 1>>
<<set $recordBookNewTrace = true>>
<<set $recordBookNewBond = true>>
<<clampStats>>

<div class="narration-screen">
<div class="narration narration-block">처마 아래에 작은 발자국이 남아 있었다.

쿠로의 것은 아니었다.
하지만 쿠로의 방을 향해 있었다.

늑대는 한동안 그 자리에 섰다.
지킨다는 말이,
늦을 때가 있다.</div>
</div>

<<stateNotice "isolation">>
<<recordNotice "trace">>
<<recordNotice "bond">>
<<continueTo "Night_PatrolEnd">>
<</page>>

:: NightPatrol_Temple_ShuraHint {"position":"2575,875","size":"100,100"}
<<page>>
<<set $nightSawShuraHint = true>>
<<set $shuraHintSeen = true>>
<<set $traceNightTempleShuraHintSeen = true>>
<<set $shura = ($shura || 0) + 1>>
<<set $recordBookNewTrace = true>>
<<clampStats>>

<div class="narration-screen">
<div class="narration narration-block">불상 앞에 검집 자국이 있었다.

누군가가 오래 서 있었다.
혹은 늑대 자신이,
기억하지 못하는 밤에 그랬다.

손이 칼자루를 찾았다.
늑대는 손을 멈췄다.</div>
</div>

<<stateNotice "shura">>
<<recordNotice "trace">>
<<continueTo "Night_PatrolEnd">>
<</page>>

:: NightPatrol_Temple_HanbeiTrace {"position":"2700,875","size":"100,100"}
<<page>>
<<set $nightFoundHanbeiTrace = true>>
<<set $nightMetHanbeiCount = ($nightMetHanbeiCount || 0) + 1>>
<<set $traceNightTempleHanbeiTraceSeen = true>>
<<set $recordBookNewTrace = true>>

<div class="narration-screen">
<div class="narration narration-block">뒤뜰에는 아무도 없다.

목검 하나가 벽에 기대어 있다.

한베의 것이다.

늑대는 그것을 한동안 본다.

오늘은 아무도 베이지 않았다.

<<if $hanbeiMidConflictSeen>>
그 목검은,
대련이 아니라 사는 연습을 떠올리게 했다.
<</if>></div>
</div>

<<recordNotice "trace">>
<<continueTo "Night_PatrolEnd">>
<</page>>

:: NightPatrol_Temple_SculptorSound {"position":"2825,875","size":"100,100"}
<<page>>
