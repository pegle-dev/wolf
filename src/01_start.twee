:: Start {"position":"1500,25","size":"100,100"}
<div class="title-screen">

  <div class="game-title">WOLF</div>
  <div class="game-subtitle-en">- SIDEWAYS -</div>

  <div class="game-tagline">검을 거두고, 말로 받아내며, 그들과의 거리를 깎자.</div>

  <div class="title-menu">
    <div class="title-menu-item">
    <<link "처음부터" "Intro_Dream_01">>
      <<set $day = 1>>
      <<set $timeOfDay = "day">>
      <<set $dayAdvancedToday = false>>
      <<set $nightPatrolActive = false>>
      <<set $nightPatrolUsedToday = false>>
      <<set $nightPatrolJustFinished = false>>
      <<set $currentMode = "temple">>
      <<set $nightPatrolUnlocked = false>>
      <<set $recordBookOpen = false>>
      <<set $recordBookTab = "endings">>
      <<set $firstDeathIntroDone = false>>
    <</link>>
    </div>

    <<if $anyEndingSeen>>
    <div class="title-menu-item">
    [[이어간다->Temple]]
    </div>
    <</if>>

    <<if $hiddenRevivalUnlocked and not $hiddenRevivalSeen>>
