:: UI_Widgets [widget] {"position":"300,75","size":"100,100"}
<<widget "page" container>>
<div class="stage page-stage">
  <div class="page-box">
    <div class="page-text">
_contents
    </div>
  </div>
</div>
<</widget>>

<<widget "talk" container>>
<div class="stage talk-stage">

  <<if $args.length > 0 and $args[0] != "">>
  <div class="portrait-box talk-portrait-box">
    <img class="portrait" @src="'assets/portraits/' + $args[0] + '.png'">
  </div>
  <</if>>

  <div class="talk-layout">
    <<if $args.length > 1 and $args[1] != "">>
    <div class="talk-nameplate">
      <<print $args[1]>>
    </div>
    <</if>>

    <div class="textbox-panel">
      <div class="dialogue">
_contents
      </div>
    </div>
  </div>

</div>
<</widget>>


:: StoryScript [script]
UIBar.stow();

Config.passages.transitionOut = 0;
Config.history.controls = false;

(function () {
  'use strict';

  function moveChoices(stage) {
    const dialogueChoice = stage.querySelector('.dialogue > .choice-box');
    if (dialogueChoice) {
      stage.appendChild(dialogueChoice);
    }
  }

  $(document).on(':passagedisplay', function () {
    const stage = document.querySelector('#passages .passage:last-child .stage');
    if (!stage) return;
    moveChoices(stage);
  });

  // 테스트용: F1로 SugarCube 기본 UI 표시/숨김.
  $(document).on('keydown', function (event) {
    if (event.key === 'F1') {
      event.preventDefault();
      document.body.classList.toggle('dev-mode');
    }
  });
}());

:: StoryStylesheet [stylesheet]
@font-face {
  font-family: 'NeoDunggeunmo Pro';
  src: url('assets/Font/NeoDunggeunmoPro-Regular.ttf') format('truetype');
  font-weight: normal;
  font-style: normal;
}

:root {
  --game-w: 960px;
  --game-h: 720px;
  --white: #e8e8e8;
  --text: #d8d8d8;
  --muted: #a8a8a8;
  --line: #777;
  --line-dark: #333;
  --black: #000;
  --panel: #050505;
}

html,
body {
  margin: 0;
  padding: 0;
  width: 100%;
  height: 100%;
  background: #000;
  color: var(--text);
  font-family: 'NeoDunggeunmo Pro', monospace;
  font-size: 22px;
  line-height: 1.42;
  overflow: hidden;
}

/* SugarCube 기본 UI: 평소 숨김, F1로 토글 */
#ui-bar {
  transform: translateX(-100%);
  transition: transform 0.18s ease;
  z-index: 10000;
}

body.dev-mode #ui-bar {
  transform: translateX(0);
}

#story {
  margin-left: 0 !important;
  width: 100vw;
  height: 100vh;
}

#passages {
  width: 100vw;
  height: 100vh;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  background: #000;
}

.passage {
  width: var(--game-w);
  height: var(--game-h);
  margin: 0 !important;
  padding: 0;
  box-sizing: border-box;
  position: relative;
  overflow: hidden;
  background: #000;
  color: var(--text);
  border: 1px solid #2a2a2a;
}

#passages > .passage:not(:last-child) {
  display: none !important;
}

.stage {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  background: #000;
}

/* --------------------
   PAGE: 장면/행동 묘사
-------------------- */
.page-stage {
  display: block;
}

.page-box {
  position: absolute;
  left: 155px;
  top: 120px;
  width: 650px;
  max-height: 520px;
  box-sizing: border-box;
  padding: 0;
  background: transparent;
  border: none;
  box-shadow: none;
  overflow: visible;
}

.page-text,
.page-text .narration,
.narration {
  color: var(--muted);
  font-size: 22px;
  line-height: 1.38;
  letter-spacing: 0.03em;
  margin: 0;
}

.narration strong {
  color: var(--white);
  font-weight: normal;
}

.page-stage .choice-box {
  margin-top: 26px;
  padding: 0;
  border: none;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.page-stage .choice-box a {
  display: block;
  width: fit-content;
  margin: 0;
  padding: 2px 8px 2px 0;
  color: var(--white);
  text-decoration: none;
  border-left: 4px solid #555;
  background: transparent;
  line-height: 1.25;
}

.page-stage .choice-box a::before {
  content: "▶ ";
  color: #777;
}

.page-stage .choice-box a:hover {
  color: #000;
  background: var(--white);
  border-left-color: var(--white);
}

.page-stage .choice-box a:hover::before {
  color: #000;
}

/* --------------------
   TALK: 포트레이트 + 이름 + 대화창
-------------------- */
.portrait-box {
  background: transparent;
  border: none;
  line-height: 0;
}

.portrait {
  display: block;
  image-rendering: pixelated;
  image-rendering: crisp-edges;
}

.talk-portrait-box {
  position: absolute;
  left: 88px;
  bottom: 108px;
  width: 190px;
  height: 190px;
  z-index: 1;
}

.talk-portrait-box .portrait {
  width: 190px;
  height: 190px;
}

.talk-layout {
  position: absolute;
  left: 300px;
  right: 78px;
  bottom: 130px;
  height: 160px;
  z-index: 2;
}

.talk-nameplate {
  position: absolute;
  left: 24px;
  top: -24px;
  width: 132px;
  height: 34px;
  box-sizing: border-box;
  z-index: 4;
  background: #000;
  border: 1px solid var(--line);
  color: var(--white);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22px;
  line-height: 1;
}

.textbox-panel {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  height: 160px;
  box-sizing: border-box;
  padding: 34px 26px 18px 26px;
  background: rgba(2, 2, 2, 0.98);
  border: 1px solid var(--line);
  box-shadow:
    0 0 0 1px #000,
    0 0 0 2px #1d1d1d;
  overflow: hidden;
}

.dialogue {
  height: 100%;
  color: var(--text);
  font-size: 22px;
  line-height: 1.38;
  letter-spacing: 0.03em;
  margin: 0;
  overflow-y: auto;
  overflow-x: hidden;
  scrollbar-width: none;
  -ms-overflow-style: none;
}

.dialogue::-webkit-scrollbar {
  display: none;
}

/* talk 선택지는 대화창 밖, 아래쪽에 고정 */
.talk-stage .choice-box {
  position: absolute;
  left: 340px;
  right: 100px;
  bottom: 48px;
  z-index: 6;
  margin: 0;
  padding: 0;
  border: 1px solid var(--line);
  background: #000;
  display: flex;
  flex-direction: column;
  gap: 0;
}

.talk-stage .choice-box a {
  display: block;
  width: auto;
  margin: 0;
  padding: 9px 18px;
  color: var(--white);
  text-decoration: none;
  text-align: center;
  border: none;
  border-bottom: 1px solid var(--line-dark);
  background: #000;
  line-height: 1.18;
}

.talk-stage .choice-box a:last-child {
  border-bottom: none;
}

.talk-stage .choice-box a::before {
  content: "▶ ";
  color: #777;
}

.talk-stage .choice-box a:hover {
  color: #000;
  background: var(--white);
}

.talk-stage .choice-box a:hover::before {
  color: #000;
}

/* 기본 링크 fallback */
.passage a {
  color: var(--white);
}

/* --------------------
   TITLE
-------------------- */
.title-screen {
  width: 100%;
  height: 100%;
  background: #000;
  color: var(--text);
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.game-title {
  font-size: 64px;
  color: #fff;
  letter-spacing: 0.18em;
  margin-bottom: 6px;
}

.game-subtitle-en {
  font-size: 24px;
  color: #888;
  letter-spacing: 0.22em;
  margin-bottom: 48px;
}

.game-tagline {
  font-size: 20px;
  color: #aaa;
  letter-spacing: 0.04em;
  margin-bottom: 52px;
}

.title-menu {
  font-size: 22px;
}

.title-menu a {
  color: #fff;
  text-decoration: none;
  border-bottom: 1px solid #666;
}

.title-menu a::before {
  content: "▶ ";
  color: #aaa;
}

.title-menu a:hover {
  color: #000;
  background: #fff;
}

.title-menu a:hover::before {
  color: #000;
}