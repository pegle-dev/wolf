/% Deprecated legacy RecordBook passage entrypoints.
   Kept only to redirect old saves or debug jumps into the overlay recordbook. %/

:: RecordBook {"position":"750,350","size":"100,100"}
<<set $recordBookOpen = true>>
<<set $recordBookTab = "endings">>
<<set $recordBookFirstOpened = true>>
<<set $recordBookNewEnding = false>>
<<set $recordBookNewTrace = false>>
<<set $recordBookNewDream = false>>
<<set $recordBookNewBond = false>>
<<goto "Temple">>

