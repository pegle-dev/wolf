:: Start {"position":"1500,25","size":"100,100"}
<div class="title-screen">

  <div class="title-main">
    <div class="game-title title-logo">WOLF</div>
    <div class="game-subtitle-en title-subtitle">- SIDEWAYS -</div>
  </div>

  <div class="title-start-block">
    <div class="game-tagline title-start-copy">검을 거두고,<br>말로 받아내며,<br>그들과의 거리를 깎자.</div>

    <div class="title-menu">
      <div class="title-menu-item">
      <<link "처음부터">>
        <<run setup.startNewGame && setup.startNewGame()>>
      <</link>>
      </div>

      <<if setup.hasAutosave && setup.hasAutosave()>>
      <div class="title-menu-item">
      <<link "이어간다">>
        <<run setup.continueAutosave && setup.continueAutosave()>>
      <</link>>
      </div>
      <</if>>

      <<if $hiddenRevivalUnlocked and not $hiddenRevivalSeen>>
      <div class="hidden-revival-title">
        그래도 만약,<br>
        당신이 다시 일어나기를 선택한다면…
      </div>

      [[회생한다.->Hidden_Rebirth_Voices]]
      <</if>>

      <<if $hiddenEndUnlocked and not $endingHiddenRememberSeen>>
      <div class="hidden-revival-title">
        어딘가에서,<br>
        같은 바람이 다시 분다.
      </div>

      [[기억한다.->Hidden_End_Remember]]
      <</if>>
    </div>
  </div>
</div>
