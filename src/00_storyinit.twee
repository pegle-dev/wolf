:: StoryInit {"position":"200,75","size":"100,100"}
/* 개발용 Debug Status Panel. 배포 시 false로 바꾸면 ] 키 패널이 비활성화된다. */
<<set $debugMode to true>>
/* 다국어 UI 구조. 기본 스토리 본문은 한국어를 유지하고, UI/system 문구부터 key 기반으로 교체한다. */
<<set $language to "ko">>

/* 진행도: 장면 단계값. max clamp 없이 루트 진행 표식으로 사용한다. */
