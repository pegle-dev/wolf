  <<set $completedSculptor = true>>
  <<set $sculptorBadFaceSeen = true>>
  <<set $badEndingSeen = true>>
  <<set $anyEndingSeen = true>>
  <<clampStats>>
<</link>>

<<link "불씨를 들여다본다" "BadEnd_Sculptor_SpreadingEmber">>
  <<set $sculptorDone = true>>
  <<set $completedSculptor = true>>
  <<set $sculptorBadFireSeen = true>>
  <<set $badEndingSeen = true>>
  <<set $anyEndingSeen = true>>
  <<set $shura += 2>>
  <<set $sculptorBadPortrait = true>>
  <<set $sculptorRouteBad = true>>
  <<clampStats>>
<</link>>
</div>
</div>
<</page>>

