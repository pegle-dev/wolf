:: StoryScript [script]
UIBar.stow();

Config.passages.transitionOut = 0;
Config.history.controls = false;

$(document).on('keydown', function (event) {
  if (event.key === '[') {
    event.preventDefault();
    document.body.classList.toggle('dev-mode');
  }

  if (event.key === ']') {
    event.preventDefault();
    document.body.classList.toggle('hide-temp-ui');
  }
});

function wolfEscapeHtml(value) {
  return String(value)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}

function wolfFormatValue(value) {
  if (value === undefined) return 'undefined';
  if (value === null) return 'null';
  if (typeof value === 'boolean') return value ? 'true' : 'false';
  if (typeof value === 'number') return String(value);
  if (typeof value === 'string') return value;

  try {
    var json = JSON.stringify(value);
    if (json.length > 32) {
      return json.slice(0, 29) + '...';
    }
    return json;
  } catch (error) {
    return String(value);
  }
}

function wolfEnsureOuterUI() {
  if ($('.outer-dev-ui').length) return;

  $('body').append(
    '<div class="outer-dev-ui">' +
      '<a href="#" class="outer-back-button" data-game-back aria-label="앞 화면으로 돌아가기" title="앞 화면으로 돌아가기">◀</a>' +
      '<div class="outer-vars-panel" aria-label="임시 변수창">' +
        '<div class="outer-vars-title">VARS</div>' +
        '<div class="outer-passage-name"></div>' +
        '<div class="outer-vars-list"></div>' +
      '</div>' +
    '</div>'
  );
}

function wolfUpdateOuterUI() {
  wolfEnsureOuterUI();

  var canGoBack = State.length > 1 && State.passage !== 'Start';
  $('.outer-back-button')
    .toggleClass('is-disabled', !canGoBack)
    .attr('aria-disabled', canGoBack ? 'false' : 'true');

  $('.outer-passage-name').text(State.passage || '');

  var vars = State.variables || {};
  var keys = Object.keys(vars).sort();

  if (!keys.length) {
    $('.outer-vars-list').html('<div class="outer-var-empty">변수 없음</div>');
    return;
  }

  var html = keys.map(function (key) {
    return '<div class="outer-var-row">' +
      '<span class="outer-var-key">$' + wolfEscapeHtml(key) + '</span>' +
      '<span class="outer-var-value">' + wolfEscapeHtml(wolfFormatValue(vars[key])) + '</span>' +
    '</div>';
  }).join('');

  $('.outer-vars-list').html(html);
}

$(document).on(':passagerender :passageend', function () {
  wolfUpdateOuterUI();
});

$(document).ready(function () {
  wolfUpdateOuterUI();
});

$(document).on('click', '[data-game-back]', function (event) {
  event.preventDefault();

  if ($(this).hasClass('is-disabled')) return;

  if (State.length > 1) {
    Engine.backward();
  }
});

:: StoryStylesheet [stylesheet]
@font-face {
  font-family: 'NeoDunggeunmo Pro';
  src: url('assets/Font/NeoDunggeunmoPro-Regular.ttf') format('truetype');
  font-weight: normal;
  font-style: normal;
}

:root {
  --game-w: 960px;
  --game-h: 720px;

  --white: #e8e8e8;
  --text: #d8d8d8;
  --muted: #a8a8a8;

  --line: #777;
  --line-soft: #383838;
  --line-dark: #242424;

  --panel: #050505;
}

html,
body {
  margin: 0;
  padding: 0;
  width: 100%;
  height: 100%;
  background: #000;
  color: var(--text);
  font-family: 'NeoDunggeunmo Pro', monospace;
  font-size: 22px;
  line-height: 1.34;
  overflow: hidden;
}

/* =========================
   SugarCube / Twine UI
   평소에는 숨김. [ 키로 표시.
========================= */
#ui-bar {
  transform: translateX(-100%);
  transition: transform 0.18s ease;
  z-index: 10000;

  background: #000 !important;
  color: var(--text) !important;
  border-right: 1px solid var(--line) !important;
  box-shadow: none !important;
  font-family: 'NeoDunggeunmo Pro', monospace !important;
}

body.dev-mode #ui-bar {
  transform: translateX(0);
}

#ui-bar-body {
  background: #000 !important;
  color: var(--text) !important;
}

#story-title,
#story-author {
  color: var(--white) !important;
  font-family: 'NeoDunggeunmo Pro', monospace !important;
  letter-spacing: 0.04em;
}

#story-title {
  font-size: 22px !important;
  border-bottom: 1px solid var(--line-soft);
  padding-bottom: 12px;
}

#menu ul,
#ui-bar ul {
  padding-left: 0 !important;
  list-style: none !important;
}

#ui-bar a,
#ui-bar button,
#menu-core button,
#menu-core a,
#menu-story button,
#menu-story a {
  color: var(--white) !important;
  background: #000 !important;
  border: 1px solid var(--line-soft) !important;
  box-shadow: none !important;
  text-decoration: none !important;
  font-family: 'NeoDunggeunmo Pro', monospace !important;
  font-size: 16px !important;
  line-height: 1.2 !important;
}

#ui-bar a:hover,
#ui-bar button:hover,
#menu-core button:hover,
#menu-core a:hover,
#menu-story button:hover,
#menu-story a:hover {
  color: #000 !important;
  background: var(--white) !important;
  border-color: var(--white) !important;
}

#ui-bar-history [id|="history"],
#ui-bar-toggle {
  color: var(--white) !important;
  background: #000 !important;
  border: 1px solid var(--line-soft) !important;
}

#story {
  margin-left: 0 !important;
  width: 100vw;
  height: 100vh;
}

#passages {
  width: 100vw;
  height: 100vh;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  background: #000;
}

.passage {
  width: var(--game-w);
  height: var(--game-h);
  margin: 0 !important;
  padding: 0;
  box-sizing: border-box;
  position: relative;
  overflow: hidden;
  background: #000;
  color: var(--text);
  border: 1px solid var(--line-dark);
}

#passages > .passage:not(:last-child) {
  display: none !important;
}

.stage,
.page-stage {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  background: #000;
}

/* =========================
   TEMP OUTER UI
   게임창 바깥 임시 UI. 나중에 빼거나 body에 hide-temp-ui 클래스를 주면 숨겨짐.
========================= */
.outer-dev-ui {
  position: fixed;
  inset: 0;
  z-index: 9000;
  pointer-events: none;
  font-family: 'NeoDunggeunmo Pro', monospace;
}

body.hide-temp-ui .outer-dev-ui {
  display: none;
}

.outer-back-button {
  position: fixed;
  left: calc(50vw - 532px);
  top: calc(50vh - 346px);
  width: 28px;
  height: 28px;
  box-sizing: border-box;
  pointer-events: auto;

  display: inline-flex;
  align-items: center;
  justify-content: center;

  color: #6f6f6f;
  background: #000;
  border: 1px solid #333;
  text-decoration: none;
  font-size: 17px;
  line-height: 1;
}

.outer-back-button:hover {
  color: #fff;
  border-color: #777;
  background: #050505;
}

.outer-back-button.is-disabled {
  opacity: 0.25;
  cursor: default;
}

.outer-vars-panel {
  position: fixed;
  left: calc(50vw + 502px);
  top: calc(50vh - 348px);
  width: 210px;
  max-height: 690px;
  box-sizing: border-box;
  padding: 12px 12px 14px 12px;
  pointer-events: auto;

  background: #000;
  color: #aaa;
  border: 1px solid #333;
  box-shadow: 0 0 0 1px #000;
  overflow-y: auto;
  overflow-x: hidden;
  scrollbar-width: none;
  -ms-overflow-style: none;
}

.outer-vars-panel::-webkit-scrollbar {
  display: none;
}

.outer-vars-title {
  color: #ddd;
  font-size: 16px;
  line-height: 1;
  letter-spacing: 0.12em;
  margin-bottom: 8px;
  padding-bottom: 8px;
  border-bottom: 1px solid #333;
}

.outer-passage-name {
  color: #777;
  font-size: 13px;
  line-height: 1.2;
  word-break: break-all;
  margin-bottom: 12px;
}

.outer-var-row {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 10px;
  align-items: baseline;
  padding: 4px 0;
  border-bottom: 1px solid #181818;
  font-size: 14px;
  line-height: 1.25;
}

.outer-var-key {
  color: #9a9a9a;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.outer-var-value {
  color: #e0e0e0;
  text-align: right;
  max-width: 84px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.outer-var-empty {
  color: #777;
  font-size: 14px;
  line-height: 1.4;
}

@media (max-width: 1240px) {
  .outer-back-button {
    left: 14px;
    top: 14px;
  }

  .outer-vars-panel {
    left: auto;
    right: 14px;
    top: 54px;
    max-height: calc(100vh - 70px);
    opacity: 0.88;
  }
}

/* =========================
   PAGE: 나레이션/행동
========================= */

.page-box {
  position: absolute;
  left: 150px;
  top: 136px;
  width: 660px;
  max-height: 520px;
  box-sizing: border-box;
  padding: 0;
  background: transparent;
  border: none;
  box-shadow: none;
  overflow-y: auto;
  overflow-x: hidden;
  scrollbar-width: none;
  -ms-overflow-style: none;
}

.page-box::-webkit-scrollbar {
  display: none;
}

.page-box,
.page-text,
.page-text .narration,
.narration {
  color: var(--muted);
  font-size: 22px;
  line-height: 1.34;
  letter-spacing: 0.03em;
  margin: 0;
  padding: 0;
  text-indent: 0;
}

.page-text > br:first-child,
.narration > br:first-child {
  display: none;
}

.narration strong {
  color: var(--white);
  font-weight: normal;
}

/* page 선택지: 나레이션 끝에서 세 줄 띄우고, 구분선 아래 표시 */
.page-stage .choice-box {
  margin-top: 66px;
  padding-top: 18px;
  border-top: 1px solid var(--line-soft);
  display: flex;
  flex-direction: column;
  gap: 18px;
  background: transparent;
}

.choice-box br {
  display: none;
}

.page-stage .choice-box a {
  display: block;
  width: fit-content;
  margin: 0;
  padding: 0;
  color: var(--white);
  text-decoration: none;
  background: transparent;
  border: none;
  line-height: 1.32;
}

.page-stage .choice-box a::before {
  content: "▶ ";
  color: #777;
}

.page-stage .choice-box a:hover,
.page-stage .choice-box a:hover::before {
  color: #fff;
  background: transparent;
}

/* =========================
   TALK: 포트레이트 + 대화창
========================= */

.portrait-box {
  background: transparent;
  border: none;
  line-height: 0;
}

.portrait {
  display: block;
  image-rendering: pixelated;
  image-rendering: crisp-edges;
}

/*
  page와 talk의 시작 높이를 맞춤.
  포트레이트는 대화창 바로 왼쪽에 붙고, 대화창 바닥 기준으로 정렬.
*/
.talk-portrait-box {
  position: absolute;
  left: 62px;
  top: 166px;
  width: 250px;
  height: 360px;
  z-index: 1;
  display: flex;
  align-items: flex-end;
  justify-content: flex-end;
}

.talk-portrait-box .portrait {
  width: 250px;
  max-width: 250px;
  max-height: 360px;
  height: auto;
  object-fit: contain;
  object-position: right bottom;
}

.talk-nameplate {
  position: absolute;
  left: 356px;
  top: 150px;
  min-width: 128px;
  height: 34px;
  padding: 0 18px;
  box-sizing: border-box;
  z-index: 4;
  background: #000;
  border: 1px solid var(--line);
  color: var(--white);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 20px;
  line-height: 1;
  white-space: nowrap;
}

.textbox-panel {
  position: absolute;
  left: 322px;
  top: 166px;
  width: 590px;
  height: 360px;
  box-sizing: border-box;
  padding: 30px 34px 22px 34px;
  background: rgba(2, 2, 2, 0.98);
  border: 1px solid var(--line);
  box-shadow:
    0 0 0 1px #000,
    0 0 0 2px #1a1a1a;
  overflow: hidden;
  z-index: 2;
}

.dialogue {
  height: 100%;
  color: var(--muted);
  font-size: 22px;
  line-height: 1.55;
  letter-spacing: 0.03em;
  margin: 0;
  padding: 0;
  text-indent: 0;
  overflow-y: auto;
  overflow-x: hidden;
  scrollbar-width: none;
  -ms-overflow-style: none;
}

.dialogue::-webkit-scrollbar {
  display: none;
}

.dialogue > br:first-child {
  display: none;
}

.talk-stage .narration {
  color: var(--muted);
  font-size: 21px;
  line-height: 1.48;
  margin: 0 0 10px 0;
}

/* talk 선택지: 구분선 아래 한 줄 띄우고, 선택지 사이도 한 줄 간격 */
.talk-stage .choice-box {
  margin-top: 16px;
  padding-top: 20px;
  border-top: 1px solid var(--line-soft);
  display: flex;
  flex-direction: column;
  gap: 18px;
  background: transparent;
}

.talk-stage .choice-box a {
  display: block;
  width: fit-content;
  margin: 0;
  padding: 0;
  color: var(--white);
  text-decoration: none;
  background: transparent;
  border: none;
  text-align: left;
  font-size: 21px;
  line-height: 1.34;
}

.talk-stage .choice-box a::before {
  content: "▶ ";
  color: #777;
}

.talk-stage .choice-box a:hover,
.talk-stage .choice-box a:hover::before {
  color: #fff;
  background: transparent;
}

.passage a {
  color: var(--white);
}

/* =========================
   TITLE
========================= */

.title-screen {
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  padding-bottom: 86px;
  background: #000;
  color: var(--text);
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.game-title {
  font-size: 64px;
  color: #fff;
  letter-spacing: 0.18em;
  margin-bottom: 4px;
}

.game-subtitle-en {
  font-size: 24px;
  color: #888;
  letter-spacing: 0.22em;
  margin-bottom: 30px;
}

.game-tagline {
  font-size: 20px;
  color: #aaa;
  letter-spacing: 0.04em;
  margin-bottom: 48px;
}

.title-menu {
  font-size: 22px;
}

.title-menu a {
  color: #fff;
  text-decoration: none;
  border-bottom: 1px solid #666;
}

.title-menu a::before {
  content: "▶ ";
  color: #aaa;
}

.title-menu a:hover {
  color: #000;
  background: #fff;
}

.title-menu a:hover::before {
  color: #000;
}