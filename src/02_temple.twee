:: Temple_Return {"position":"2025,1200","size":"100,100"}
<<page>>
<<if $completedHanbei && $completedKuro && $completedGenichiro>>
  <<set $secondLoopUnlocked to true>>
  <<set $secondRoutesUnlocked to true>>
<</if>>

<<if $completedSculptor && $completedIsshin>>
  <<set $shuraUnlocked to true>>
<</if>>
<<set $sceneCount += 1>>
<<set $returnTo = "Temple_Return_Hub">>
<<goto "EventRouter">>
<</page>>


