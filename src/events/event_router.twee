:: EventRouter {"position":"1900,1200","size":"100,100"}
<<if $hanbeiLove >= 5 and ($sharedSake_hanbei or $maskInterest) and not $hanbeiMaskEventSeen>>
  <<goto "Hanbei_05_Mask">>
<<elseif $hanbeiLove >= 6 and ($hanbeiMaskEventSeen or $sharedSake_hanbei) and not $hanbeiImmortalityTalkSeen>>
  <<goto "Hanbei_06_Immortality">>
<<elseif $hanbeiLove >= 7 and $hanbeiImmortalityTalkSeen and not $hanbeiDawnTrainingSeen>>
  <<goto "Hanbei_07_DawnTrainingGround">>
<<elseif $hanbeiLove >= 8 and $hanbeiDawnTrainingSeen and not $hanbeiMortalBladeTalkSeen>>
  <<goto "Hanbei_08_MortalBlade">>
<<elseif $hanbeiMortalBladeTalkSeen and not $hanbeiPushAwaySeen>>
  <<goto "Hanbei_08_PushAway">>
<<elseif $hanbeiMortalBladeTalkSeen>>
  <<goto "Hanbei_09_FinalChoice">>
<<else>>
  <<if $returnTo>>
    <<goto $returnTo>>
  <<else>>
    <<goto "Temple">>
  <</if>>
<</if>>
