/* Sideways 한베 루트 변수. 기획: docs/Wolf_Sideways_Hanbei.md */
<<set $day to 1>>
<<set $hanbeiDist to 0>>        /* 거리 0~4: 대련 / 검 하나 / 곁에 앉음 / 어깨 / 등 */
<<set $hanbeiCrack to 0>>       /* 균열 0~3: 늑대가 솔직해진 횟수 */
<<set $hanbeiVisits to 0>>      /* 한베를 찾아간 날 수 */
<<set $skippedYesterday to false>>   /* 직전 낮에 한베를 찾아가지 않았는가 */
<<set $memories to []>>         /* 인연 기억 카드 id 목록 */
<<set $hanbeiSkips to 0>>       /* 한베를 찾아가지 않은 날 수 */
<<set $hanbeiApologized to false>>  /* 2일차: 미안하다고 했는가 */
<<set $honestToday to false>>   /* 그날 솔직했는가 (하루 끝에 균열 +1) */
<<set $shura to 0>>             /* 수라 씨앗: 베는 쪽으로 기운 선택 수. 3 이상이면 마지막에 수라 선택지 */
<<set $color to false>>         /* 4일차 술잔 이후 색이 돌아온다 (늑대의 목도리 등) */
<<set $hanbeiSake to false>>    /* 4일차: 잔을 받았는가 */
<<set $lookedMask to false>>    /* 4일차: 술잔 대신 얼굴을 보았는가 */
<<set $saidNoCut to false>>     /* 6일차: 베고 싶지 않다고 말했는가 */
<<set $promised to false>>      /* 6일차: 부탁을 받아들였는가 */
<<set $sawFace to false>>       /* 6일차: 가면 아래 얼굴을 보았는가 */
<<set $leftHim to false>>       /* 7일차: 돌아섰는가 */
<<set $emptyKind to "silence">>
<<set $lastEnding to "">>

