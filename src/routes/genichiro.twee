:: Genichiro {"position":"2050,1475","size":"100,100"}
<<goto "Go_Genichiro">>

:: Genichiro01 {"position":"2050,1600","size":"100,100"}
<<goto "Go_Genichiro">>

:: Go_Genichiro {"position":"2050,1725","size":"100,100"}
<<set $currentRoute = "genichiro">>

<<if not $genichiroGateSeen>>
  <<goto "Genichiro_01_Gate">>
<<elseif not $genichiroRooftopSeen>>
  <<goto "Genichiro_02_Rooftop">>
<<elseif not $genichiroFullDuelSeen>>
  <<goto "Genichiro_03_FullDuel">>
<<elseif not $genichiroMoonSakeSeen>>
  <<goto "Genichiro_04_MoonSake">>
<<elseif not $genichiroWoundSeen>>
  <<goto "Genichiro_05_Wound">>
<<elseif not $genichiroAshinaConfessionSeen>>
  <<goto "Genichiro_06_AshinaConfession">>
<<elseif not $genichiroDoNotReturnSeen>>
  <<goto "Genichiro_07_DoNotReturn">>
<<elseif not $genichiroDone>>
  <<goto "Genichiro_EndingRouter">>
<<else>>
  <<goto "Genichiro_AfterEnding">>
<</if>>

:: Genichiro_EndingRouter {"position":"2050,2850","size":"100,100"}
<<if $shura >= 8>>
  <<goto "BadEnd_Genichiro_LightningWolf">>
<<elseif $genichiroLove >= 5 and $isolation >= 8>>
  <<goto "BadEnd_Genichiro_SinkingCastle">>
<<elseif $freedom <= 1 and $missionObedienceCount >= 3>>
  <<goto "BadEnd_Genichiro_KneelingCastle">>
<<elseif $genichiroLove >= 5 and $freedom >= 3 and ($kuroLove >= 3 or $kuroGoodEndingSeen)>>
  <<goto "Ending_Genichiro_SameMoon">>
<<elseif $genichiroLove >= 4 and $danger >= 6 and $shura < 7>>
  <<goto "Ending_Genichiro_Footprints">>
<<else>>
  <<goto "Ending_Genichiro_SettingMoonCastle">>
<</if>>

:: Genichiro_01_Gate {"position":"2175,1725","size":"100,100"}
<<page>>
<<set $currentRoute = "genichiro">>
<<set $genichiroProgress = Math.max($genichiroProgress, 1)>>
<<set $genichiroGateSeen = true>>

<div class="narration">
성문에서의 전투가 끝났다.

겐이치로는 성으로 돌아가고 있었다.
등은 곧았다.
피가 흘러도, 걸음은 흐트러지지 않았다.

늑대는 멀리서 그를 보았다.
</div>

<div class="choice-box">[[계속->Genichiro_01_Gate_Beat02]]</div>
<</page>>

:: Genichiro_01_Gate_Beat02 {"position":"2300,1725","size":"100,100"}
<<page>>
<div class="narration">
적이다.
쿠로님을 빼앗으려 한 자다.
베어야 할 자다.

그러나 그 등에는,
버릴 수 없는 것을 짊어진 사람의 무게가 있었다.

늑대는 그 무게를 알았다.
</div>

<div class="choice-box">[[계속->Genichiro_01_Gate_Choice]]</div>
<</page>>

:: Genichiro_01_Gate_Choice {"position":"2425,1725","size":"100,100"}
<<page>>
<div class="choice-box">
<<link "그를 따라간다" "Temple_Return">>
  <<set $genichiroLove += 1>>
  <<set $danger += 1>>
  <<set $genichiroFollowed = true>>
  <<clampStats>>
<</link>>

<<link "멀리서 지켜본다" "Temple_Return">>
  <<set $genichiroLove += 1>>
  <<clampStats>>
<</link>>

<<link "쿠로님께 돌아간다" "Temple_Return">>
  <<set $kuroLove += 1>>
  <<set $isolation += 1>>
  <<clampStats>>
<</link>>
</div>
<</page>>

