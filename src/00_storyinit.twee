:: StoryInit {"position":"200,75","size":"100,100"}
/* 개발용 Debug Status Panel. 배포 시 false로 바꾸면 ] 키 패널이 비활성화된다. */
<<set $debugMode to true>>

/* 진행도: 장면 단계값. max clamp 없이 루트 진행 표식으로 사용한다. */
<<set $hanbeiProgress to 0>>
<<set $kuroProgress to 0>>
<<set $genichiroProgress to 0>>
<<set $sculptorProgress to 0>>
<<set $isshinProgress to 0>>

/* 호감도: -5 ~ +10 */
<<set $hanbeiLove to 0>>
<<set $kuroLove to 0>>
<<set $genichiroLove to 0>>
<<set $sculptorLove to 0>>
<<set $isshinLove to 0>>

/* 공통 수치: 0 ~ 20 */
<<set $isolation to 0>>
<<set $danger to 0>>
<<set $shura to 0>>
<<set $sceneCount to 0>>
<<set $currentRoute to "">>
<<set $returnTo to "Temple">>

/* 아이템/이벤트 플래그 */
<<set $hasSake to false>>
<<set $sharedSake_hanbei to false>>
<<set $maskInterest to false>>
<<set $hanbeiMaskInterest to false>>
<<set $hanbeiMaskEventSeen to false>>
<<set $hanbeiMaskTouched to false>>
<<set $hanbeiDeepTalk to false>>
<<set $hanbeiImmortalityTalkSeen to false>>
<<set $hanbeiDawnTrainingSeen to false>>
<<set $hanbeiReasonAnswer to "">>
<<set $hanbeiMortalBladeTalkSeen to false>>
<<set $hanbeiMercyRequest to false>>
<<set $hanbeiMaskRemoved to false>>
<<set $emmaIsshinIntroSeen to false>>

/* 엔딩 완료 플래그 */
<<set $completedHanbei to false>>
<<set $completedKuro to false>>
<<set $completedGenichiro to false>>
<<set $completedSculptor to false>>
<<set $completedIsshin to false>>
<<set $anyEndingSeen to false>>
<<set $badEndingSeen to false>>
<<set $hanbeiDone to false>>
<<set $hanbeiGoodEndingSeen to false>>
<<set $hanbeiBadEndingSeen to false>>
<<set $hanbeiMercyEndingSeen to false>>
<<set $hanbeiSwordBadEndingSeen to false>>

/* 해금 플래그 */
<<set $secondLoopUnlocked to false>>
<<set $secondRoutesUnlocked to false>>
<<set $isshinUnlocked to false>>
<<set $shuraUnlocked to false>>
