:: DayEvent_Router {"position":"1700,550","size":"100,100"}
<<run setup.ensureTimeVariables && setup.ensureTimeVariables()>>
<<run setup.ensureEventCooldowns && setup.ensureEventCooldowns()>>
<<run setup.ensureBondVariables && setup.ensureBondVariables()>>
<<set $timeOfDay = "day">>
<<set $dailyEventCount = ($dailyEventCount || 0) + 1>>

<<if ($dayCount || $day || 1) < 2>>
  <<goto "DayEvent_None">>
<</if>>

<<set _roll = random(1, 100)>>
<<if ($shura || 0) >= 4 and _roll <= 25 and setup.canRouteEvent("day", "Temple_Daily_Danger_ShuraHand")>>
  <<goto "Temple_Daily_Danger_ShuraHand">>
<<elseif ($danger || 0) >= 4 and _roll <= 45 and setup.canRouteEvent("day", "Temple_Daily_Danger_WoundHidden")>>
  <<goto "Temple_Daily_Danger_WoundHidden">>
<<elseif ($danger || 0) >= 3 and ($hanbeiMidConflictSeen || false) and _roll <= 58 and setup.canRouteEvent("day", "Temple_Daily_Danger_HanbeiStops")>>
  <<goto "Temple_Daily_Danger_HanbeiStops">>
<<elseif ($isolation || 0) >= 4 and _roll <= 66>>
  <<set _lonelyRoll = random(1, 3)>>
  <<if _lonelyRoll == 1 and setup.canRouteEvent("day", "Temple_Daily_Lonely_EmptyTemple")>>
    <<goto "Temple_Daily_Lonely_EmptyTemple">>
  <<elseif _lonelyRoll == 2 and setup.canRouteEvent("day", "Temple_Daily_Lonely_ColdTea")>>
    <<goto "Temple_Daily_Lonely_ColdTea">>
  <<elseif setup.canRouteEvent("day", "Temple_Daily_Lonely_StoppedCarving")>>
    <<goto "Temple_Daily_Lonely_StoppedCarving">>
  <<else>>
    <<goto "DayEvent_None">>
  <</if>>
<<elseif _roll <= 84>>
  <<set _healingRoll = random(1, 3)>>
  <<if _healingRoll == 1 and setup.canRouteEvent("day", "Temple_Daily_Healing_TeaAndWood")>>
    <<goto "Temple_Daily_Healing_TeaAndWood">>
  <<elseif _healingRoll == 2 and setup.canRouteEvent("day", "Temple_Daily_Healing_HanbeiNap")>>
    <<goto "Temple_Daily_Healing_HanbeiNap">>
  <<elseif setup.canRouteEvent("day", "Temple_Daily_Healing_TeaAndWood")>>
    <<goto "Temple_Daily_Healing_TeaAndWood">>
  <<else>>
    <<goto "Temple_Daily_Healing_TeaAndWood">>
  <</if>>
<<elseif _roll <= 94 and (($emmaAffection || 0) + ($hanbeiAffection || 0)) >= 1 and setup.canRouteEvent("day", "Temple_Daily_Mediation_HanbeiKuro")>>
  <<goto "Temple_Daily_Mediation_HanbeiKuro">>
<<elseif (($sculptorUnlocked || false) or ($secondLoopUnlocked || false)) and setup.canRouteEvent("day", "Temple_Daily_Lonely_StoppedCarving")>>
  <<goto "Temple_Daily_Lonely_StoppedCarving">>
<<elseif setup.canRouteEvent("day", "DayEvent_SilentTemple")>>
  <<goto "DayEvent_SilentTemple">>
<<else>>
  <<goto "DayEvent_None">>
<</if>>

:: DayEvent_None {"position":"1825,550","size":"100,100"}
<<page>>
<<run setup.markRoutedEvent && setup.markRoutedEvent("day", "DayEvent_None", 0)>>
<<set $timeOfDay = "day">>
<div class="narration-screen">
<div class="narration narration-block">절은 조용했다.

낮의 바람만이
무너진 처마 아래를 지나갔다.</div>
</div>

<<continueTo "Temple">>
<</page>>

:: Temple_Daily_Healing_TeaAndWood {"position":"1950,750","size":"100,100"}
<<page>>
<<run setup.markRoutedEvent && setup.markRoutedEvent("day", "Temple_Daily_Healing_TeaAndWood", 1)>>
<<set $templeDailyTeaSeen = true>>
<<set $dailyHealingCount = ($dailyHealingCount || 0) + 1>>
<<set $isolation = Math.max(0, ($isolation || 0) - 1)>>
<<set $kuroAffection = ($kuroAffection || 0) + 1>>
<<set $kuroLove = Math.max(($kuroLove || 0), (($kuroAffection || 0) + ($kuroConflict || 0)))>>
<<clampStats>>
<div class="narration-screen">
<div class="narration narration-block">성 쪽에서 묻어온 차 향이
아직 소매 끝에 남아 있었다.

멀리서는 나무를 깎는 소리가 났다.

뒤뜰 쪽에서는 목검이 바닥을 두드리는 소리가 한 번.

늑대는 문가에 섰다.

아무도 그에게 명령하지 않았다.

그런데도,
그는 한동안 움직이지 않았다.</div>
</div>

<<continueTo "Temple_Daily_Healing_TeaAndWood_Talk01">>
