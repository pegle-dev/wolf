:: Isshin_06_FinalChoice_Choices {"position":"2525,1575","size":"100,100"}
<<page>>
<div class="route-choice-screen">
<div class="choice-box route-choice-box">
<<if $isshinLove >= 4 or $isshinSatWithoutSword or $isshinHeardWarning>>
<<link "술잔을 든다" "Ending_Isshin_ReedSake">>
  <<set $isshinDone = true>>
  <<set $completedIsshin = true>>
  <<set $isshinGoodEndingSeen = true>>
  <<set $anyEndingSeen = true>>
  <<if $sculptorDone and $isshinDone>>
    <<set $shuraUnlocked = true>>
  <</if>>
  <<clampStats>>
<</link>>
<</if>>

<<link "빈 잔을 내려놓는다" "BadEnd_Isshin_EmptyCup">>
  <<set $isshinDone = true>>
  <<set $completedIsshin = true>>
  <<set $isshinBadEmptyCupSeen = true>>
  <<set $badEndingSeen = true>>
  <<set $anyEndingSeen = true>>
  <<if $sculptorDone and $isshinDone>>
    <<set $shuraUnlocked = true>>
  <</if>>
  <<clampStats>>
<</link>>

<<link "검을 든다" "BadEnd_Isshin_SwordDemonLaugh">>
  <<set $isshinDone = true>>
  <<set $completedIsshin = true>>
  <<set $isshinBadSwordLaughSeen = true>>
  <<set $badEndingSeen = true>>
  <<set $anyEndingSeen = true>>
  <<set $shura += 2>>
  <<set $isshinBadPortrait = true>>
  <<set $isshinRouteBad = true>>
  <<if $sculptorDone and $isshinDone>>
    <<set $shuraUnlocked = true>>
  <</if>>
  <<clampStats>>
<</link>>
</div>
</div>
<</page>>

:: Ending_Isshin_ReedSake {"position":"2400,1750","size":"100,100"}
