:: ReturnEvent_HanbeiPretendSleep {"position":"2925,1050","size":"100,100"}
<<page>>
<<run setup.markRoutedEvent && setup.markRoutedEvent("return", "ReturnEvent_HanbeiPretendSleep", 1)>>
