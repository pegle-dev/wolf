:: CommonBadEndRouter {"position":"5600,900","size":"100,100"}
<<set $commonBadPending = true>>
<<set _shuraWarningSeen = (($sculptorShuraWarningSeen || false) or ($sculptorShuraPreludeSeen || false) or ($isshinShuraWarningSeen || false) or ($isshinShuraPreludeSeen || false))>>
<<set _owlVoiceTotal = ($owlVoiceCount || 0) + ($fatherObedienceCount || 0) + ($missionObedienceCount || 0)>>
<<set _refusedHelpTotal = ($refusedHelpCount || 0) + ($helpRefusedCount || 0)>>

/% 공통 배드엔딩:
danger / isolation / low freedom의 실패.
구출 이벤트로 막지 않는다.

수라 구출 이벤트:
shura가 일정 이상 올라 검에게 먹히기 직전 발생하는 브레이크.
관계가 늑대를 구원하는 것이 아니라, 수라의 흐름을 한 번 끊는다.

수라 루트:
플레이어가 직접 [죽인다]를 선택해 들어가는 히든 루트.
수라 구출 이벤트로 강제 중단하지 않는다.
%/

<<if ($shura || 0) >= 5 and ($shuraHintSeen || false) and _shuraWarningSeen>>
  <<goto "Ending_Shura_LastChoice">>
<<elseif _owlVoiceTotal >= 4 and ($isolation || 0) >= 5 and ($danger || 0) >= 4 and _refusedHelpTotal >= 2 and ($shura || 0) < 5 and not ($endingHiddenOwlsWolfSeen || false)>>
  <<set $commonBadLevel = 4>>
  <<goto "Hidden_End_OwlsWolf_01">>
<<elseif $isolation >= 12 and $danger >= 10 and $freedom <= 1 and $helpRefusedCount >= 3>>
  <<set $commonBadLevel = 4>>
  <<goto "BadEnd_OwlWolf">>
<<elseif $fatherObedienceCount >= 2 and $isolation >= 10>>
  <<set $commonBadLevel = 4>>
  <<goto "BadEnd_OwlWolf">>
<<elseif $isolation >= 10 and $danger >= 8>>
  <<set $commonBadLevel = 3>>
  <<goto "BadEnd_TamedWolf">>
<<elseif $isolation >= 8 and $freedom <= 1>>
  <<set $commonBadLevel = 2>>
  <<goto "BadEnd_EmptyScabbard">>
<<else>>
  <<set $commonBadLevel = 1>>
  <<goto "BadEnd_MissingNight">>
<</if>>

:: Rescue_Router {"position":"5600,1050","size":"100,100"}
/% 호환용 alias. 실제 의미는 수라 구출 전용 라우터다. %/
<<goto "ShuraRescue_Router">>

:: ShuraRiskRouter {"position":"5600,1025","size":"100,100"}
<<if $shura >= 8>>
  <<goto "ShuraRescue_Router">>
<<elseif $nightPatrolActive>>
  <<goto "Night_PatrolEnd">>
<<else>>
  <<goto "Temple_Return">>
<</if>>

:: ShuraRescue_Router {"position":"5600,1150","size":"100,100"}
<<if $currentRoute == "hanbei" and (($hanbeiLove >= 4) or $hanbeiGoodEndingSeen) and not $hanbeiRescueSeen>>
  <<goto "Rescue_Hanbei">>
<<elseif $currentRoute == "kuro" and (($kuroLove >= 4) or $kuroGoodEndingSeen) and not $kuroRescueSeen>>
  <<goto "Rescue_Kuro">>
<<elseif $currentRoute == "genichiro" and (($genichiroLove >= 4) or $genichiroGoodEndingSeen) and not $genichiroRescueSeen>>
  <<goto "Rescue_Genichiro">>
<<elseif $currentRoute == "sculptor" and (($sculptorLove >= 4) or $sculptorGoodEndingSeen) and not $sculptorRescueSeen>>
  <<goto "Rescue_Sculptor">>
<<elseif $currentRoute == "isshin" and (($isshinLove >= 4) or $isshinGoodEndingSeen) and not $isshinRescueSeen>>
  <<goto "Rescue_Isshin">>
<<elseif (($kuroLove >= 4) or $kuroGoodEndingSeen) and not $kuroRescueSeen>>
  <<goto "Rescue_Kuro">>
<<elseif (($hanbeiLove >= 4) or $hanbeiGoodEndingSeen) and not $hanbeiRescueSeen>>
  <<goto "Rescue_Hanbei">>
<<elseif (($genichiroLove >= 4) or $genichiroGoodEndingSeen) and not $genichiroRescueSeen>>
  <<goto "Rescue_Genichiro">>
<<elseif (($sculptorLove >= 4) or $sculptorGoodEndingSeen) and not $sculptorRescueSeen>>
  <<goto "Rescue_Sculptor">>
<<elseif (($isshinLove >= 4) or $isshinGoodEndingSeen) and not $isshinRescueSeen>>
  <<goto "Rescue_Isshin">>
<<else>>
  <<goto "Shura_NoRescue_Result">>
<</if>>

:: CommonBadEndRouter_NoRescue {"position":"5600,1200","size":"100,100"}
