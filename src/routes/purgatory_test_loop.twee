:: Purgatory_EndingRouter {"position":"3350,75","size":"100,100"}
<<set $currentMode = "purgatory">>
<<if $shura >= 3>>
  <<goto "Purgatory_Ending_Shura_Mini">>
<<elseif $fatherVoice >= 2 and $fatherVoice >= $echoHanbei and $fatherVoice >= $echoKuro>>
  <<goto "Purgatory_Ending_FatherVoice_Mini">>
<<elseif $isolation >= 3 and $echoHanbei <= 1 and $echoKuro <= 1>>
  <<goto "Purgatory_Ending_Worst_Mini">>
<<elseif $echoHanbei >= 2 and $echoHanbei > $echoKuro>>
  <<goto "Purgatory_Ending_Hanbei_Mini">>
<<elseif $echoKuro >= 2 and $echoKuro >= $echoHanbei>>
  <<goto "Purgatory_Ending_Kuro_Mini">>
<<else>>
  <<goto "Purgatory_Ending_Normal_Mini">>
<</if>>

