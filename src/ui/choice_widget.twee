:: Widget_ChoiceTo [widget]

<<widget "choiceTo">><<nobr>>
	<<set _label = _args[0]>>
	<<set _target = _args[1]>>
	<<set _extraClass = _args[2] || "">>
	<<if _extraClass>>
		<div class="global-choice-item shura-choice"><<link _label>><<goto _target>><</link>></div>
	<<else>>
		<div class="global-choice-item"><<link _label>><<goto _target>><</link>></div>
	<</if>>
<</nobr>><</widget>>
