/* disabled: page/talk are now defined safely in StoryScript via Macro.add */


:: StoryScript [script]
/* Wolf UI macros: JS로 직접 정의해서 widget/_contents 꼬임을 피한다. */
(function () {
  'use strict';

  function wikiInto(element, source) {
    jQuery(element).wiki(source || '');
  }

  function makeEl(tag, className, text) {
    var el = document.createElement(tag);
    if (className) {
      el.className = className;
    }
    if (text !== undefined && text !== null && text !== '') {
      el.textContent = String(text);
    }
    return el;
  }

  if (Macro.has('page')) {
    Macro.delete('page');
  }
  if (Macro.has('talk')) {
    Macro.delete('talk');
  }

  Macro.add('page', {
    tags : null,
    handler : function () {
      var stage = makeEl('div', 'stage page-stage');
      var box = makeEl('div', 'page-box');
      var text = makeEl('div', 'page-text');

      stage.appendChild(box);
      box.appendChild(text);
      wikiInto(text, this.payload[0].contents);
      this.output.appendChild(stage);
    }
  });

  Macro.add('talk', {
    tags : null,
    handler : function () {
      var portrait = this.args.length > 0 ? String(this.args[0] || '') : '';
      var speaker = this.args.length > 1 ? String(this.args[1] || '') : '';

      var row = makeEl('div', 'talk-row ' + (portrait ? 'has-portrait' : 'no-portrait'));

      if (portrait) {
        var portraitBox = makeEl('div', 'talk-portrait-box');
        var img = document.createElement('img');
        img.className = 'portrait';
        img.src = 'assets/portraits/' + portrait + '.png';
        portraitBox.appendChild(img);
        row.appendChild(portraitBox);
      }
      else {
        row.appendChild(makeEl('div', 'talk-portrait-box is-empty'));
      }

      var panelWrap = makeEl('div', 'talk-panel-wrap');
      if (speaker) {
        panelWrap.appendChild(makeEl('div', 'talk-nameplate', speaker));
      }

      var panel = makeEl('div', 'textbox-panel');
      var dialogue = makeEl('div', 'dialogue');
      panel.appendChild(dialogue);
      panelWrap.appendChild(panel);
      row.appendChild(panelWrap);

      wikiInto(dialogue, this.payload[0].contents);
      this.output.appendChild(row);
    }
  });
}());

UIBar.stow();

Config.passages.transitionOut = 0;
Config.history.controls = false;

$(document).on('keydown', function (event) {
  if (event.key === '[') {
    event.preventDefault();
    document.body.classList.toggle('dev-mode');
  }

  if (event.key === ']') {
    event.preventDefault();
    document.body.classList.toggle('hide-temp-ui');
  }
});

function wolfEscapeHtml(value) {
  return String(value)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}

function wolfFormatValue(value) {
  if (value === undefined) return 'undefined';
  if (value === null) return 'null';
  if (typeof value === 'boolean') return value ? 'true' : 'false';
  if (typeof value === 'number') return String(value);
  if (typeof value === 'string') return value;

  try {
    var json = JSON.stringify(value);
    if (json.length > 32) {
      return json.slice(0, 29) + '...';
    }
    return json;
  } catch (error) {
    return String(value);
  }
}

function wolfEnsureOuterUI() {
  if ($('.outer-dev-ui').length) return;

  $('body').append(
    '<div class="outer-dev-ui">' +
      '<a href="#" class="outer-back-button" data-game-back aria-label="앞 화면으로 돌아가기" title="앞 화면으로 돌아가기">◀</a>' +
      '<div class="outer-vars-panel" aria-label="임시 변수창">' +
        '<div class="outer-vars-title">VARS</div>' +
        '<div class="outer-passage-name"></div>' +
        '<div class="outer-vars-list"></div>' +
      '</div>' +
    '</div>'
  );
}

function wolfUpdateOuterUI() {
  wolfEnsureOuterUI();

  var canGoBack = State.length > 1 && State.passage !== 'Start';
  $('.outer-back-button')
    .toggleClass('is-disabled', !canGoBack)
    .attr('aria-disabled', canGoBack ? 'false' : 'true');

  $('.outer-passage-name').text(State.passage || '');

  var vars = State.variables || {};
  var keys = Object.keys(vars).sort();

  if (!keys.length) {
    $('.outer-vars-list').html('<div class="outer-var-empty">변수 없음</div>');
    return;
  }

  var html = keys.map(function (key) {
    return '<div class="outer-var-row">' +
      '<span class="outer-var-key">$' + wolfEscapeHtml(key) + '</span>' +
      '<span class="outer-var-value">' + wolfEscapeHtml(wolfFormatValue(vars[key])) + '</span>' +
    '</div>';
  }).join('');

  $('.outer-vars-list').html(html);
}

$(document).on(':passagerender :passageend', function () {
  wolfUpdateOuterUI();
});

$(document).ready(function () {
  wolfUpdateOuterUI();
});

$(document).on('click', '[data-game-back]', function (event) {
  event.preventDefault();

  if ($(this).hasClass('is-disabled')) return;

  if (State.length > 1) {
    Engine.backward();
  }
});

:: StoryStylesheet [stylesheet]
@font-face {
  font-family: 'NeoDunggeunmo Pro';
  src: url('assets/Font/NeoDunggeunmoPro-Regular.ttf') format('truetype');
  font-weight: normal;
  font-style: normal;
}

:root {
  --game-w: 960px;
  --game-h: 720px;

  --white: #e8e8e8;
  --text: #d8d8d8;
  --muted: #a8a8a8;

  --line: #777;
  --line-soft: #383838;
  --line-dark: #242424;

  --panel: #050505;
}

html,
body {
  margin: 0;
  padding: 0;
  width: 100%;
  height: 100%;
  background: #000;
  color: var(--text);
  font-family: 'NeoDunggeunmo Pro', monospace;
  font-size: 22px;
  line-height: 1.34;
  overflow: hidden;
}

/* =========================
   SugarCube / Twine UI
   [ 키: 왼쪽 기본 UI 표시
   ] 키: 바깥 임시 UI 숨김
========================= */

#ui-bar {
  transform: translateX(-100%);
  transition: transform 0.18s ease;
  z-index: 10000;
  background: #000 !important;
  color: var(--text) !important;
  border-right: 1px solid var(--line) !important;
  box-shadow: none !important;
  font-family: 'NeoDunggeunmo Pro', monospace !important;
}

body.dev-mode #ui-bar {
  transform: translateX(0);
}

#ui-bar-body {
  background: #000 !important;
  color: var(--text) !important;
}

#story-title,
#story-author {
  color: var(--white) !important;
  font-family: 'NeoDunggeunmo Pro', monospace !important;
  letter-spacing: 0.04em;
}

#story-title {
  font-size: 22px !important;
  border-bottom: 1px solid var(--line-soft);
  padding-bottom: 12px;
}

#menu ul,
#ui-bar ul {
  padding-left: 0 !important;
  list-style: none !important;
}

#ui-bar a,
#ui-bar button,
#menu-core button,
#menu-core a,
#menu-story button,
#menu-story a {
  color: var(--white) !important;
  background: #000 !important;
  border: 1px solid var(--line-soft) !important;
  box-shadow: none !important;
  text-decoration: none !important;
  font-family: 'NeoDunggeunmo Pro', monospace !important;
  font-size: 16px !important;
  line-height: 1.2 !important;
}

#ui-bar a:hover,
#ui-bar button:hover,
#menu-core button:hover,
#menu-core a:hover,
#menu-story button:hover,
#menu-story a:hover {
  color: #000 !important;
  background: var(--white) !important;
  border-color: var(--white) !important;
}

#ui-bar-history [id|="history"],
#ui-bar-toggle {
  color: var(--white) !important;
  background: #000 !important;
  border: 1px solid var(--line-soft) !important;
}

/* =========================
   SugarCube 기본 화면
========================= */

#story {
  margin-left: 0 !important;
  width: 100vw;
  height: 100vh;
}

#passages {
  width: 100vw;
  height: 100vh;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  background: #000;
}

.passage {
  width: var(--game-w);
  height: var(--game-h);
  margin: 0 !important;
  padding: 0;
  box-sizing: border-box;
  position: relative;
  overflow: hidden;
  background: #000;
  color: var(--text);
  border: 1px solid var(--line-dark);
}

#passages > .passage:not(:last-child) {
  display: none !important;
}

.stage,
.page-stage {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  background: #000;
}

.passage a {
  color: var(--white);
}

/* =========================
   바깥 임시 UI / 변수창
========================= */

.outer-dev-ui {
  position: fixed;
  inset: 0;
  z-index: 9000;
  pointer-events: none;
  font-family: 'NeoDunggeunmo Pro', monospace;
}

body.hide-temp-ui .outer-dev-ui {
  display: none;
}

.outer-back-button {
  position: fixed;
  left: calc(50vw - 532px);
  top: calc(50vh - 346px);
  width: 28px;
  height: 28px;
  box-sizing: border-box;
  pointer-events: auto;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: #6f6f6f;
  background: #000;
  border: 1px solid #333;
  text-decoration: none;
  font-size: 17px;
  line-height: 1;
}

.outer-back-button:hover {
  color: #fff;
  border-color: #777;
  background: #050505;
}

.outer-back-button.is-disabled {
  opacity: 0.25;
  cursor: default;
}

.outer-vars-panel {
  position: fixed;
  left: calc(50vw + 502px);
  top: calc(50vh - 348px);
  width: 210px;
  max-height: 690px;
  box-sizing: border-box;
  padding: 12px 12px 14px 12px;
  pointer-events: auto;
  background: #000;
  color: #aaa;
  border: 1px solid #333;
  box-shadow: 0 0 0 1px #000;
  overflow-y: auto;
  overflow-x: hidden;
  scrollbar-width: none;
  -ms-overflow-style: none;
}

.outer-vars-panel::-webkit-scrollbar {
  display: none;
}

.outer-vars-title {
  color: #ddd;
  font-size: 16px;
  line-height: 1;
  letter-spacing: 0.12em;
  margin-bottom: 8px;
  padding-bottom: 8px;
  border-bottom: 1px solid #333;
}

.outer-passage-name {
  color: #777;
  font-size: 13px;
  line-height: 1.2;
  word-break: break-all;
  margin-bottom: 12px;
}

.outer-var-row {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 10px;
  align-items: baseline;
  padding: 4px 0;
  border-bottom: 1px solid #181818;
  font-size: 14px;
  line-height: 1.25;
}

.outer-var-key {
  color: #9a9a9a;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.outer-var-value {
  color: #e0e0e0;
  text-align: right;
  max-width: 84px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.outer-var-empty {
  color: #777;
  font-size: 14px;
  line-height: 1.4;
}

@media (max-width: 1240px) {
  .outer-back-button {
    left: 14px;
    top: 14px;
  }

  .outer-vars-panel {
    left: auto;
    right: 14px;
    top: 54px;
    max-height: calc(100vh - 70px);
    opacity: 0.88;
  }
}

/* =========================
   PAGE: 나레이션/행동
   talk도 page 안에서 자연스럽게 배치됨.
========================= */

.page-box {
  position: absolute;
  left: 90px;
  top: 78px;
  width: 780px;
  max-height: 585px;
  box-sizing: border-box;
  padding: 0;
  background: transparent;
  border: none;
  box-shadow: none;
  overflow-y: auto;
  overflow-x: hidden;
  scrollbar-width: none;
  -ms-overflow-style: none;
  text-align: left;
}

.page-box::-webkit-scrollbar {
  display: none;
}

.page-text,
.page-text .narration,
.narration {
  color: var(--muted);
  font-size: 22px;
  line-height: 1.42;
  letter-spacing: 0.03em;
  margin: 0;
  padding: 0;
  text-indent: 0;
  text-align: left;
}

.page-text > br:first-child,
.narration > br:first-child,
.page-text > p:first-child:empty,
.narration > p:first-child:empty {
  display: none;
}

.narration strong {
  color: var(--white);
  font-weight: normal;
}

/* =========================
   TALK: page 안에 들어가는 안전한 대화 블록
   기존처럼 <<page>> 안에 <<talk>>를 여러 개 써도 깨지지 않음.
========================= */

.talk-row {
  display: grid;
  grid-template-columns: 220px 1fr;
  column-gap: 14px;
  align-items: end;
  width: 100%;
  margin: 12px 0 18px 0;
  box-sizing: border-box;
}

.talk-row.no-portrait {
  grid-template-columns: 0 1fr;
  column-gap: 0;
}

.talk-portrait-box {
  width: 220px;
  height: 260px;
  display: flex;
  align-items: flex-end;
  justify-content: flex-end;
  overflow: hidden;
}

.talk-portrait-box.is-empty {
  display: none;
}

.portrait {
  display: block;
  width: 220px;
  max-width: 220px;
  max-height: 260px;
  height: auto;
  object-fit: contain;
  object-position: right bottom;
  image-rendering: pixelated;
  image-rendering: crisp-edges;
}

.talk-panel-wrap {
  position: relative;
  width: 100%;
  min-height: 178px;
  box-sizing: border-box;
}

.talk-nameplate {
  position: absolute;
  left: 28px;
  top: -22px;
  min-width: 118px;
  height: 34px;
  padding: 0 18px;
  box-sizing: border-box;
  z-index: 2;
  background: #000;
  border: 1px solid var(--line);
  color: var(--white);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 20px;
  line-height: 1;
  white-space: nowrap;
}

.textbox-panel {
  width: 100%;
  min-height: 178px;
  box-sizing: border-box;
  padding: 38px 32px 24px 32px;
  background: rgba(2, 2, 2, 0.98);
  border: 1px solid var(--line);
  box-shadow:
    0 0 0 1px #000,
    0 0 0 2px #1a1a1a;
  overflow: hidden;
}

.dialogue {
  color: var(--muted);
  font-size: 22px;
  line-height: 1.55;
  letter-spacing: 0.03em;
  margin: 0;
  padding: 0;
  text-indent: 0;
  text-align: left;
}

.dialogue > br:first-child {
  display: none;
}

/* =========================
   선택지
========================= */

.choice-box {
  margin-top: 34px;
  padding-top: 14px;
  border-top: 1px solid var(--line-soft);
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 12px;
  background: transparent;
  text-align: left;
}

.choice-box br {
  display: none;
}

.choice-box .narration {
  margin: 0 0 10px 0 !important;
  padding: 0 !important;
  text-align: left !important;
  line-height: 1.34 !important;
}

.choice-box a {
  display: block;
  width: fit-content;
  margin: 0;
  padding: 0;
  color: var(--white);
  text-decoration: none;
  background: transparent;
  border: none;
  line-height: 1.34;
  text-align: left;
  font-size: 21px;
}

.choice-box a::before {
  content: "▶ ";
  color: #777;
}

.choice-box a:hover,
.choice-box a:hover::before {
  color: #fff;
  background: transparent;
}

/* =========================
   TITLE
========================= */

.title-screen {
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  padding-bottom: 86px;
  background: #000;
  color: var(--text);
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.game-title {
  font-size: 64px;
  color: #fff;
  letter-spacing: 0.18em;
  margin-bottom: 4px;
}

.game-subtitle-en {
  font-size: 24px;
  color: #888;
  letter-spacing: 0.22em;
  margin-bottom: 30px;
}

.game-tagline {
  font-size: 20px;
  color: #aaa;
  letter-spacing: 0.04em;
  margin-bottom: 48px;
}

.title-menu {
  font-size: 22px;
  text-align: left;
}

.title-menu a {
  color: #fff;
  text-decoration: none;
  border-bottom: 1px solid #666;
}

.title-menu a::before {
  content: "▶ ";
  color: #aaa;
}

.title-menu a:hover {
  color: #000;
  background: #fff;
}

.title-menu a:hover::before {
  color: #000;
}

.final-intro {
  color: #d0d0d0;
  font-style: italic;
  text-align: left;
  box-sizing: border-box;
}