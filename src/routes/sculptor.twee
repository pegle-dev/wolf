<<if $sculptorLove >= 4 or $sculptorPromisedReturn or $sculptorAcceptedWarning>>
<<link "불상 곁에 앉는다" "Ending_Sculptor_LeftBehindBuddha">>
  <<set $sculptorDone = true>>
  <<set $completedSculptor = true>>
  <<set $sculptorGoodEndingSeen = true>>
  <<set $anyEndingSeen = true>>
  <<clampStats>>
<</link>>
<</if>>

<<link "아직 얼굴이 없다고 말한다" "BadEnd_Sculptor_UncarvedFace">>
