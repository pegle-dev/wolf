:: Kuro_TempleNotice {"position":"2225,875","size":"100,100"}
<<if $kuroTempleNoticeSeen>>
  <<goto "Kuro_Router">>
<</if>>
<<page>>
<<run setup.ensureTimeVariables && setup.ensureTimeVariables()>>
<<set $kuroTempleNoticeSeen = true>>
<<set $timeOfDay = "day">>
<div class="narration-screen scene-bg-temple">
<div class="narration narration-block">늑대는 문 앞에서 잠시 머뭇거렸다.
주군의 화는 조금 풀리셨을까.</div>
</div>

<<continueTo "Kuro_Router">>
<</page>>

:: Kuro_Router {"position":"2225,925","size":"100,100"}
<<set $currentRoute = "kuro">>
<<run setup.ensureTimeVariables && setup.ensureTimeVariables()>>
<<run setup.ensureBondVariables && setup.ensureBondVariables()>>

<<if ($nightFoundKuroTrace or $kuroTraceSeen or (($nightFoundKuroTraceCount || 0) > 0)) and not $kuroReactedNightLantern>>
  <<set $nightReactionReturn = "Kuro_Router">>
  <<goto "Kuro_React_NightLantern">>
<</if>>

<<if ($dayCount || $day || 1) < 3 or not ($badEndFirstDeathSeen || false)>>
  <<goto "Kuro_NotYet">>
<<elseif not ($kuroTeaSeen || false)>>
  <<goto "Kuro_02_Tea">>
<<elseif not ($kuroReadingSeen || false)>>
  <<goto "Kuro_01_Reading">>
<<elseif not ($kuroSitBesideSeen || false)>>
  <<goto "Kuro_03_SitBeside">>
<<elseif not ($kuroMidConflictSeen || false) and ((setup.getBond && setup.getBond("kuro") >= 2) or (($kuroAffection || 0) + ($kuroConflict || 0)) >= 2 or ($kuroOrderLanguageSeen || false) or ($kuroLove || 0) >= 3)>>
  <<goto "Kuro_MidConflict">>
<<elseif not ($kuroWaitingSeen || false)>>
  <<goto "Kuro_04_Waiting">>
<<elseif not ($kuroWishSeen || false)>>
  <<goto "Kuro_05_Wish">>
<<elseif not ($kuroNameSeen || false)>>
  <<goto "Kuro_06_Name">>
<<elseif not ($kuroAlmostLostSeen || false)>>
  <<goto "Kuro_06_ReturnPlace">>
<<elseif ($kuroDone || false)>>
  <<goto "Kuro_AfterEnding">>
<<else>>
  <<goto "Kuro_07_FinalChoice">>
<</if>>

