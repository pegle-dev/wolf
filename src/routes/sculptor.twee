:: Sculptor_02_ShowHand_Choice {"position":"3000,675","size":"100,100"}
<<page>>
<div class="route-choice-screen">
<div class="choice-box route-choice-box">
<<link "손을 보인다" "Sculptor_02_ShowHand_Show_Result">>
  <<set $sculptorAffection = ($sculptorAffection || 0) + 1>>
  <<set $sculptorSawWound = true>>
  <<set $sculptorLove = Math.max(($sculptorLove || 0), (($sculptorAffection || 0) + ($sculptorConflict || 0)))>>
  <<clampStats>>
<</link>>

<<link "소매를 내린다" "Sculptor_02_ShowHand_Hide_Result">>
  <<set $sculptorConflict = ($sculptorConflict || 0) + 1>>
  <<set $sculptorHidWound = true>>
  <<set $isolation = ($isolation || 0) + 1>>
  <<clampStats>>
<</link>>

<<link "붕대를 받는다" "Sculptor_02_ShowHand_Bandage_Result">>
  <<set $sculptorAffection = ($sculptorAffection || 0) + 1>>
  <<set $danger = ($danger || 0) - 1>>
  <<set $sculptorLove = Math.max(($sculptorLove || 0), (($sculptorAffection || 0) + ($sculptorConflict || 0)))>>
  <<clampStats>>
<</link>>
</div>
</div>
<</page>>

:: Sculptor_02_ShowHand_Show_Result {"position":"3125,675","size":"100,100"}
