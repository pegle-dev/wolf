:: Genichiro_03_FullDuel {"position":"2175,2025","size":"100,100"}
<<page>>
<<set $currentRoute = "genichiro">>
<<set $genichiroProgress = Math.max($genichiroProgress, 3)>>
<<set $genichiroFullDuelSeen = true>>

<div class="narration">
