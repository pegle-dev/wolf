:: RecordBook {"position":"750,350","size":"100,100"}
<<goto "RecordBook_Endings">>

:: RecordBook_Endings {"position":"875,350","size":"100,100"}
<<set _seen = 0>>
<<if $hanbeiGoodEndingSeen>><<set _seen += 2>><</if>>
<<if $hanbeiMercyEndingSeen>><<set _seen += 1>><</if>>
<<if $hanbeiSwordBadEndingSeen>><<set _seen += 1>><</if>>
<<if $kuroGoodEndingSeen>><<set _seen += 1>><</if>>
<<if $kuroBadLastOrderSeen>><<set _seen += 1>><</if>>
<<if $kuroBadTeahouseSeen>><<set _seen += 1>><</if>>
<<if $genichiroGoodEndingSeen>><<set _seen += 1>><</if>>
<<if $endingGenichiroSameMoonSeen>><<set _seen += 1>><</if>>
<<if $endingGenichiroFootprintsSeen>><<set _seen += 1>><</if>>
<<if $badEndGenichiroSinkingCastleSeen>><<set _seen += 1>><</if>>
<<if $badEndGenichiroLightningWolfSeen>><<set _seen += 1>><</if>>
<<if $badEndGenichiroKneelingCastleSeen>><<set _seen += 1>><</if>>
<<if $sculptorGoodEndingSeen>><<set _seen += 1>><</if>>
<<if $sculptorBadFaceSeen>><<set _seen += 1>><</if>>
<<if $sculptorBadFireSeen>><<set _seen += 1>><</if>>
<<if $isshinGoodEndingSeen>><<set _seen += 1>><</if>>
<<if $isshinBadEmptyCupSeen>><<set _seen += 1>><</if>>
<<if $isshinBadSwordLaughSeen>><<set _seen += 1>><</if>>
<<if $badMissingNightSeen>><<set _seen += 1>><</if>>
<<if $badEmptyScabbardSeen>><<set _seen += 1>><</if>>
<<if $badTamedWolfSeen>><<set _seen += 1>><</if>>
<<if $badOwlWolfSeen>><<set _seen += 1>><</if>>
<<if $shuraEndingSeen>><<set _seen += 1>><</if>>
<<if $hiddenRevivalDone>><<set _seen += 1>><</if>>

<div class="recordbook-dim"></div>
<div class="recordbook-panel">
  <div class="recordbook-header">
    <div class="recordbook-title">기록장</div>
    <div class="recordbook-close">[[닫는다->Temple]]</div>
  </div>

  <div class="recordbook-tabs">
    <span class="recordbook-tab active">엔딩</span>
    [[꿈->RecordBook_Dreams]]
    [[인연->RecordBook_Bonds]]
    [[흔적->RecordBook_Traces]]
  </div>

  <div class="recordbook-summary">엔딩 <<= _seen>> / 25</div>

  <div class="recordbook-list">
    <div class="recordbook-item <<if not $hanbeiGoodEndingSeen>>locked<</if>>">
      <div class="recordbook-item-title"><<if $hanbeiGoodEndingSeen>>[End. 그냥 온 날] / [End. 곁에 앉은 침묵]<<else>>[???]<</if>></div>
      <div class="recordbook-item-desc"><<if $hanbeiGoodEndingSeen>>한베와 검을 뽑지 않는 시간을 남겼다.<<else>>아직 보지 못한 결말이다.<</if>></div>
    </div>

    <div class="recordbook-item <<if not $hanbeiMercyEndingSeen>>locked<</if>>">
      <div class="recordbook-item-title"><<if $hanbeiMercyEndingSeen>>[Bad End. 끝나는 대련]<<else>>[???]<</if>></div>
      <div class="recordbook-item-desc"><<if $hanbeiMercyEndingSeen>>끝을 바라는 약속을 받아들였다.<<else>>아직 보지 못한 결말이다.<</if>></div>
    </div>

    <div class="recordbook-item <<if not $hanbeiSwordBadEndingSeen>>locked<</if>>">
      <div class="recordbook-item-title"><<if $hanbeiSwordBadEndingSeen>>[Bad End. 불사를 베는 연습]<<else>>[???]<</if>></div>
      <div class="recordbook-item-desc"><<if $hanbeiSwordBadEndingSeen>>대련은 끝까지 대련으로 남았다.<<else>>아직 보지 못한 결말이다.<</if>></div>
    </div>

    <div class="recordbook-item <<if not $kuroGoodEndingSeen>>locked<</if>>">
      <div class="recordbook-item-title"><<if $kuroGoodEndingSeen>>[End. 주인 없는 길]<<else>>[???]<</if>></div>
      <div class="recordbook-item-desc"><<if $kuroGoodEndingSeen>>주군과 닌자라는 이름 너머의 길을 보았다.<<else>>아직 보지 못한 결말이다.<</if>></div>
    </div>

    <div class="recordbook-item <<if not ($kuroBadLastOrderSeen or $kuroBadTeahouseSeen)>>locked<</if>>">
      <div class="recordbook-item-title"><<if $kuroBadLastOrderSeen or $kuroBadTeahouseSeen>>[Bad End. 쿠로의 그림자]<<else>>[???]<</if>></div>
      <div class="recordbook-item-desc"><<if $kuroBadLastOrderSeen or $kuroBadTeahouseSeen>>명령과 약속 사이에서 돌아오지 못한 길.<<else>>아직 보지 못한 결말이다.<</if>></div>
    </div>

    <div class="recordbook-item <<if not ($genichiroGoodEndingSeen or $endingGenichiroSameMoonSeen or $endingGenichiroFootprintsSeen)>>locked<</if>>">
      <div class="recordbook-item-title"><<if $genichiroGoodEndingSeen or $endingGenichiroSameMoonSeen or $endingGenichiroFootprintsSeen>>[End. 아시나의 달]<<else>>[???]<</if>></div>
      <div class="recordbook-item-desc"><<if $genichiroGoodEndingSeen or $endingGenichiroSameMoonSeen or $endingGenichiroFootprintsSeen>>겐이치로와 같은 성, 같은 달 아래에 섰다.<<else>>아직 보지 못한 결말이다.<</if>></div>
    </div>

    <div class="recordbook-item <<if not ($badEndGenichiroSinkingCastleSeen or $badEndGenichiroLightningWolfSeen or $badEndGenichiroKneelingCastleSeen)>>locked<</if>>">
      <div class="recordbook-item-title"><<if $badEndGenichiroSinkingCastleSeen or $badEndGenichiroLightningWolfSeen or $badEndGenichiroKneelingCastleSeen>>[Bad End. 꺾이지 않는 성]<<else>>[???]<</if>></div>
      <div class="recordbook-item-desc"><<if $badEndGenichiroSinkingCastleSeen or $badEndGenichiroLightningWolfSeen or $badEndGenichiroKneelingCastleSeen>>성은 무너졌고, 검은 다른 이름으로 남았다.<<else>>아직 보지 못한 결말이다.<</if>></div>
    </div>

    <div class="recordbook-item <<if not $sculptorGoodEndingSeen>>locked<</if>>">
      <div class="recordbook-item-title"><<if $sculptorGoodEndingSeen>>[End. 남겨진 불상]<<else>>[???]<</if>></div>
      <div class="recordbook-item-desc"><<if $sculptorGoodEndingSeen>>불상 곁에 남은 것은 벌이 아니라 기억이었다.<<else>>아직 보지 못한 결말이다.<</if>></div>
    </div>

    <div class="recordbook-item <<if not $isshinGoodEndingSeen>>locked<</if>>">
      <div class="recordbook-item-title"><<if $isshinGoodEndingSeen>>[End. 갈대밭의 술자리]<<else>>[???]<</if>></div>
      <div class="recordbook-item-desc"><<if $isshinGoodEndingSeen>>검 대신 술잔을 든 밤이 있었다.<<else>>아직 보지 못한 결말이다.<</if>></div>
    </div>

    <div class="recordbook-item <<if not ($badMissingNightSeen or $badEmptyScabbardSeen or $badTamedWolfSeen or $badOwlWolfSeen)>>locked<</if>>">
      <div class="recordbook-item-title"><<if $badMissingNightSeen or $badEmptyScabbardSeen or $badTamedWolfSeen or $badOwlWolfSeen>>[Bad End. 공통 실패의 흔적]<<else>>[???]<</if>></div>
      <div class="recordbook-item-desc"><<if $badMissingNightSeen or $badEmptyScabbardSeen or $badTamedWolfSeen or $badOwlWolfSeen>>고립과 위험이 늑대의 길을 덮었다.<<else>>아직 보지 못한 결말이다.<</if>></div>
    </div>

    <div class="recordbook-item <<if not $shuraEndingSeen>>locked<</if>>">
      <div class="recordbook-item-title"><<if $shuraEndingSeen>>[End. 수라]<<else>>[???]<</if>></div>
      <div class="recordbook-item-desc"><<if $shuraEndingSeen>>검이 사람을 삼킨 끝을 보았다.<<else>>아직 보지 못한 결말이다.<</if>></div>
    </div>

    <div class="recordbook-item <<if not $hiddenRevivalDone>>locked<</if>>">
      <div class="recordbook-item-title"><<if $hiddenRevivalDone>>[End. 돌아갈 길]<<else>>[???]<</if>></div>
      <div class="recordbook-item-desc"><<if $hiddenRevivalDone>>검 없이도 걸어갈 수 있는 길이 남았다.<<else>>아직 보지 못한 결말이다.<</if>></div>
    </div>
  </div>
</div>

:: RecordBook_Dreams {"position":"1000,350","size":"100,100"}
<<set _seen = 0>>
<<if $dangerTrapDreamSeen>><<set _seen += 1>><</if>>
<<if $hanbeiDreamSeen>><<set _seen += 1>><</if>>
<<if $kuroDreamSeen>><<set _seen += 1>><</if>>
<<if $genichiroDreamSeen>><<set _seen += 1>><</if>>
<<if $sculptorDreamSeen>><<set _seen += 1>><</if>>
<<if $isshinDreamSeen>><<set _seen += 1>><</if>>
<<if $isolationDreamSeen>><<set _seen += 1>><</if>>
<<if $isolationChildBattlefieldDreamSeen>><<set _seen += 1>><</if>>
<<if $dangerDreamSeen>><<set _seen += 1>><</if>>
<<if $forgottenNightmareSeen>><<set _seen += 1>><</if>>

<div class="recordbook-dim"></div>
<div class="recordbook-panel">
  <div class="recordbook-header">
    <div class="recordbook-title">기록장</div>
    <div class="recordbook-close">[[닫는다->Temple]]</div>
  </div>
  <div class="recordbook-tabs">
    [[엔딩->RecordBook_Endings]]
    <span class="recordbook-tab active">꿈</span>
    [[인연->RecordBook_Bonds]]
    [[흔적->RecordBook_Traces]]
  </div>
  <div class="recordbook-summary">꿈 <<= _seen>> / 10</div>
  <div class="recordbook-list">
    <div class="recordbook-item <<if not $dangerTrapDreamSeen>>locked<</if>>"><div class="recordbook-item-title"><<if $dangerTrapDreamSeen>>[발목을 감은 꿈]<<else>>[???]<</if>></div><div class="recordbook-item-desc"><<if $dangerTrapDreamSeen>>몸이 먼저 위험을 기억하기 시작했을 때 나타난 꿈.<<else>>아직 꾸지 않은 꿈이다.<</if>></div></div>
    <div class="recordbook-item <<if not $hanbeiDreamSeen>>locked<</if>>"><div class="recordbook-item-title"><<if $hanbeiDreamSeen>>[다시 일어나는 무사]<<else>>[???]<</if>></div><div class="recordbook-item-desc"><<if $hanbeiDreamSeen>>이기고 싶은 것이 아니라, 쉬게 하고 싶었던 꿈.<<else>>아직 꾸지 않은 꿈이다.<</if>></div></div>
    <div class="recordbook-item <<if not $kuroDreamSeen>>locked<</if>>"><div class="recordbook-item-title"><<if $kuroDreamSeen>>[명령하지 않는 주군]<<else>>[???]<</if>></div><div class="recordbook-item-desc"><<if $kuroDreamSeen>>뒤따르는 발걸음을 믿는 어린 주군의 꿈.<<else>>아직 꾸지 않은 꿈이다.<</if>></div></div>
    <div class="recordbook-item <<if not $genichiroDreamSeen>>locked<</if>>"><div class="recordbook-item-title"><<if $genichiroDreamSeen>>[불타는 성 위]<<else>>[???]<</if>></div><div class="recordbook-item-desc"><<if $genichiroDreamSeen>>베어야 할 이유를 찾지 못한 채 성을 올려다본 꿈.<<else>>아직 꾸지 않은 꿈이다.<</if>></div></div>
    <div class="recordbook-item <<if not $sculptorDreamSeen>>locked<</if>>"><div class="recordbook-item-title"><<if $sculptorDreamSeen>>[늑대를 닮은 불상]<<else>>[???]<</if>></div><div class="recordbook-item-desc"><<if $sculptorDreamSeen>>깎이는 나무와 함께 안쪽의 무언가가 떨어져 나간 꿈.<<else>>아직 꾸지 않은 꿈이다.<</if>></div></div>
    <div class="recordbook-item <<if not $isshinDreamSeen>>locked<</if>>"><div class="recordbook-item-title"><<if $isshinDreamSeen>>[검에게 먹히지 않는 자]<<else>>[???]<</if>></div><div class="recordbook-item-desc"><<if $isshinDreamSeen>>죽음을 알고도 웃는 검사의 꿈.<<else>>아직 꾸지 않은 꿈이다.<</if>></div></div>
    <div class="recordbook-item <<if not $isolationDreamSeen>>locked<</if>>"><div class="recordbook-item-title"><<if $isolationDreamSeen>>[발자국 없는 안개]<<else>>[???]<</if>></div><div class="recordbook-item-desc"><<if $isolationDreamSeen>>찾던 이름마저 잊어 가는 고독의 꿈.<<else>>아직 꾸지 않은 꿈이다.<</if>></div></div>
    <div class="recordbook-item <<if not $isolationChildBattlefieldDreamSeen>>locked<</if>>"><div class="recordbook-item-title"><<if $isolationChildBattlefieldDreamSeen>>[어린 전장]<<else>>[???]<</if>></div><div class="recordbook-item-desc"><<if $isolationChildBattlefieldDreamSeen>>누구도 이름을 부르지 않던 오래전 꿈.<<else>>아직 꾸지 않은 꿈이다.<</if>></div></div>
    <div class="recordbook-item <<if not $dangerDreamSeen>>locked<</if>>"><div class="recordbook-item-title"><<if $dangerDreamSeen>>[붙잡는 손들]<<else>>[???]<</if>></div><div class="recordbook-item-desc"><<if $dangerDreamSeen>>죽은 자와 죽지 못한 자들의 손이 남긴 꿈.<<else>>아직 꾸지 않은 꿈이다.<</if>></div></div>
    <div class="recordbook-item <<if not $forgottenNightmareSeen>>locked<</if>>"><div class="recordbook-item-title"><<if $forgottenNightmareSeen>>[잊힌 악몽]<<else>>[???]<</if>></div><div class="recordbook-item-desc"><<if $forgottenNightmareSeen>>내용은 사라졌지만, 손바닥의 힘만 남은 꿈.<<else>>아직 꾸지 않은 꿈이다.<</if>></div></div>
  </div>
</div>

:: RecordBook_Bonds {"position":"1125,350","size":"100,100"}
<div class="recordbook-dim"></div>
<div class="recordbook-panel">
  <div class="recordbook-header">
    <div class="recordbook-title">기록장</div>
    <div class="recordbook-close">[[닫는다->Temple]]</div>
  </div>
  <div class="recordbook-tabs">
    [[엔딩->RecordBook_Endings]]
    [[꿈->RecordBook_Dreams]]
    <span class="recordbook-tab active">인연</span>
    [[흔적->RecordBook_Traces]]
  </div>
  <div class="recordbook-summary">인연은 숫자가 아니라 남은 기억으로 기록된다.</div>
  <div class="recordbook-list">
    <div class="recordbook-section-title">한베</div>
    <div class="recordbook-item <<if not $sharedSake_hanbei>>locked<</if>>"><div class="recordbook-item-title"><<if $sharedSake_hanbei>>술잔을 나눈 날<<else>>???<</if>></div><div class="recordbook-item-desc"><<if $sharedSake_hanbei>>늑대는 죽지 않는 무사가 건넨 술잔을 받았다.<<else>>아직 남지 않은 기억이다.<</if>></div></div>
    <div class="recordbook-item <<if not $hanbeiMaskEventSeen>>locked<</if>>"><div class="recordbook-item-title"><<if $hanbeiMaskEventSeen>>가려진 얼굴<<else>>???<</if>></div><div class="recordbook-item-desc"><<if $hanbeiMaskEventSeen>>한베는 웃음 너머의 얼굴을 숨기지 않기 시작했다.<<else>>아직 남지 않은 기억이다.<</if>></div></div>
    <div class="recordbook-item <<if not $hanbeiImmortalityTalkSeen>>locked<</if>>"><div class="recordbook-item-title"><<if $hanbeiImmortalityTalkSeen>>끝나지 않는 몸<<else>>???<</if>></div><div class="recordbook-item-desc"><<if $hanbeiImmortalityTalkSeen>>불사의 피로가 처음으로 말이 되었다.<<else>>아직 남지 않은 기억이다.<</if>></div></div>

    <div class="recordbook-section-title">쿠로</div>
    <div class="recordbook-item <<if not $kuroReadingSeen>>locked<</if>>"><div class="recordbook-item-title"><<if $kuroReadingSeen>>책을 읽는 시간<<else>>???<</if>></div><div class="recordbook-item-desc"><<if $kuroReadingSeen>>글을 읽는 기쁨이 조용히 남았다.<<else>>아직 남지 않은 기억이다.<</if>></div></div>
    <div class="recordbook-item <<if not $kuroWishSeen>>locked<</if>>"><div class="recordbook-item-title"><<if $kuroWishSeen>>명령이 아닌 부탁<<else>>???<</if>></div><div class="recordbook-item-desc"><<if $kuroWishSeen>>주군의 말이 임무가 아닌 바람으로 들렸다.<<else>>아직 남지 않은 기억이다.<</if>></div></div>

    <div class="recordbook-section-title">겐이치로</div>
    <div class="recordbook-item <<if not $genichiroMoonSakeSeen>>locked<</if>>"><div class="recordbook-item-title"><<if $genichiroMoonSakeSeen>>같은 달<<else>>???<</if>></div><div class="recordbook-item-desc"><<if $genichiroMoonSakeSeen>>성 위의 달 아래서, 적의 이름이 조금 달라졌다.<<else>>아직 남지 않은 기억이다.<</if>></div></div>
    <div class="recordbook-item <<if not $genichiroDoNotReturnSeen>>locked<</if>>"><div class="recordbook-item-title"><<if $genichiroDoNotReturnSeen>>돌아가지 마라<<else>>???<</if>></div><div class="recordbook-item-desc"><<if $genichiroDoNotReturnSeen>>붙잡힌 말은 명령보다 오래 남았다.<<else>>아직 남지 않은 기억이다.<</if>></div></div>

    <div class="recordbook-section-title">조각가 / 잇신</div>
    <div class="recordbook-item <<if not $sculptorFaceSeen>>locked<</if>>"><div class="recordbook-item-title"><<if $sculptorFaceSeen>>깎이지 않는 얼굴<<else>>???<</if>></div><div class="recordbook-item-desc"><<if $sculptorFaceSeen>>불상들 사이에 남은 얼굴을 보았다.<<else>>아직 남지 않은 기억이다.<</if>></div></div>
    <div class="recordbook-item <<if not $isshinReedFieldSeen>>locked<</if>>"><div class="recordbook-item-title"><<if $isshinReedFieldSeen>>갈대밭의 사람<<else>>???<</if>></div><div class="recordbook-item-desc"><<if $isshinReedFieldSeen>>검사의 웃음과 죽음의 거리가 가까워졌다.<<else>>아직 남지 않은 기억이다.<</if>></div></div>
  </div>
</div>

:: RecordBook_Traces {"position":"1250,350","size":"100,100"}
<<set _seen = 0>>
<<if $traceFirstNightPatrol>><<set _seen += 1>><</if>>
<<if $traceFirstDream>><<set _seen += 1>><</if>>
<<if $traceSharedDrink>><<set _seen += 1>><</if>>
<<if $traceFirstEnding or $anyEndingSeen>><<set _seen += 1>><</if>>
<<if $resistedKneeling>><<set _seen += 1>><</if>>
<<if $trapEventSeen>><<set _seen += 1>><</if>>

<div class="recordbook-dim"></div>
<div class="recordbook-panel">
  <div class="recordbook-header">
    <div class="recordbook-title">기록장</div>
    <div class="recordbook-close">[[닫는다->Temple]]</div>
  </div>
  <div class="recordbook-tabs">
    [[엔딩->RecordBook_Endings]]
    [[꿈->RecordBook_Dreams]]
    [[인연->RecordBook_Bonds]]
    <span class="recordbook-tab active">흔적</span>
  </div>
  <div class="recordbook-summary">흔적 <<= _seen>> / 6</div>
  <div class="recordbook-list">
    <div class="recordbook-item <<if not $traceFirstNightPatrol>>locked<</if>>"><div class="recordbook-item-title"><<if $traceFirstNightPatrol>>[첫 밤정찰]<<else>>[???]<</if>></div><div class="recordbook-item-desc"><<if $traceFirstNightPatrol>>밤의 길을 처음 걸었다.<<else>>아직 남지 않은 흔적이다.<</if>></div></div>
    <div class="recordbook-item <<if not $traceFirstDream>>locked<</if>>"><div class="recordbook-item-title"><<if $traceFirstDream>>[첫 번째 꿈]<<else>>[???]<</if>></div><div class="recordbook-item-desc"><<if $traceFirstDream>>잠든 뒤, 늑대의 안쪽이 모습을 드러냈다.<<else>>아직 남지 않은 흔적이다.<</if>></div></div>
    <div class="recordbook-item <<if not $traceSharedDrink>>locked<</if>>"><div class="recordbook-item-title"><<if $traceSharedDrink>>[술잔을 나눈 늑대]<<else>>[???]<</if>></div><div class="recordbook-item-desc"><<if $traceSharedDrink>>누군가와 술을 나누었다.<<else>>아직 남지 않은 흔적이다.<</if>></div></div>
    <div class="recordbook-item <<if not ($traceFirstEnding or $anyEndingSeen)>>locked<</if>>"><div class="recordbook-item-title"><<if $traceFirstEnding or $anyEndingSeen>>[돌아온 늑대]<<else>>[???]<</if>></div><div class="recordbook-item-desc"><<if $traceFirstEnding or $anyEndingSeen>>처음으로 하나의 결말을 보았다.<<else>>아직 남지 않은 흔적이다.<</if>></div></div>
    <div class="recordbook-item <<if not $resistedKneeling>>locked<</if>>"><div class="recordbook-item-title"><<if $resistedKneeling>>[무릎 꿇지 않은 밤]<<else>>[???]<</if>></div><div class="recordbook-item-desc"><<if $resistedKneeling>>몸이 기억하는 굴복을 거슬렀다.<<else>>아직 남지 않은 흔적이다.<</if>></div></div>
    <div class="recordbook-item <<if not $trapEventSeen>>locked<</if>>"><div class="recordbook-item-title"><<if $trapEventSeen>>[함정의 흔적]<<else>>[???]<</if>></div><div class="recordbook-item-desc"><<if $trapEventSeen>>밤길이 항상 길만은 아니라는 것을 알았다.<<else>>아직 남지 않은 흔적이다.<</if>></div></div>
  </div>
</div>
