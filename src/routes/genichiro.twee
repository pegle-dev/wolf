<<elseif ($genichiroMidConflictSeen || false) and (($genichiroConflict || 0) >= 3 or ($genichiroLogicSeed || false)) and (($wolfProtectsAgainstWill || 0) >= 2 or ($ironGuardFlag || false) or ($genichiroWorstReady || false) or (($missionObedienceCount || 0) >= 3 and ($freedom || 0) <= 1))>>
  <<goto "Ending_Genichiro_Worst_IronGuard">>
<<elseif ($genichiroMidConflictSeen || false) and (($endingGenichiroDaySeen || false) or ($endingGenichiroBadSeen || false) or ($genichiroGoodEndingSeen || false) or ($badEndGenichiroSinkingCastleSeen || false)) and ($genichiroMirrorRecognized || false) and ((setup.getBond && setup.getBond("genichiro") >= 4) or (($genichiroAffection || 0) + ($genichiroConflict || 0)) >= 4 or ($genichiroLove || 0) >= 5) and ($genichiroConflict || 0) >= 2 and ($wolfProtectsAgainstWill || 0) < 2 and ($shura || 0) < 4>>
  <<goto "Ending_Genichiro_True_MirrorSide">>
<<elseif $genichiroLove >= 5 and $isolation >= 8>>
  <<goto "EchoRouter_Genichiro_Bad_BehindName">>
<<elseif $freedom <= 1 and $missionObedienceCount >= 3>>
  <<goto "BadEnd_Genichiro_KneelingCastle">>
<<elseif $genichiroLove >= 5 and $freedom >= 3 and ($kuroLove >= 3 or $kuroGoodEndingSeen)>>
  <<goto "Ending_Genichiro_SameMoon">>
<<elseif $genichiroLove >= 4 and $danger >= 6 and $shura < 7>>
  <<goto "Ending_Genichiro_Footprints">>
<<else>>
  <<goto "EchoRouter_Genichiro_Day_OneInch">>
<</if>>

